"use client";

import { useEffect, useMemo, useRef, useState } from "react";
import Link from "next/link";
import { useRouter } from "next/navigation";
import { AnimatePresence, motion, useReducedMotion } from "framer-motion";
import { DeployHistory } from "@/src/components/DeployHistory";
import { SwipeableCard } from "@/src/components/SwipeableCard";
import type { ReviewRequest, ReviewRiskTier, ReviewStatus } from "@/src/lib/reviewData";

const NOTIFICATION_ENDPOINT_KEY = "pp-push-subscription-endpoint";
const SEEN_REQUESTS_KEY = "pp-seen-review-requests";
const ACTION_DEBOUNCE_MS = 300;
const VAPID_PUBLIC_KEY = "BDxQpyTln1dWnopnrg3ypZfWlf4eGYNDGbFs8IfYc-dvRjHMWK3OGwhSew6kBqXp51aYaR7qvd2SjlvU2MyIm6w";

type ReviewsResponse = {
  requests: ReviewRequest[];
  generatedAt: string;
};

type ActionState = {
  id: string;
  action: "approve" | "deny";
};

function urlBase64ToUint8Array(base64String: string) {
  const padding = "=".repeat((4 - (base64String.length % 4)) % 4);
  const base64 = (base64String + padding).replace(/-/g, "+").replace(/_/g, "/");
  const rawData = window.atob(base64);

  return Uint8Array.from(rawData, (char) => char.charCodeAt(0));
}

async function storePushSubscription() {
  if (!("serviceWorker" in navigator) || !("PushManager" in window)) {
    return;
  }

  const registration = await navigator.serviceWorker.ready;
  let subscription = await registration.pushManager.getSubscription();

  if (!subscription) {
    subscription = await registration.pushManager.subscribe({
      userVisibleOnly: true,
      applicationServerKey: urlBase64ToUint8Array(VAPID_PUBLIC_KEY)
    });
  }

  window.localStorage.setItem(NOTIFICATION_ENDPOINT_KEY, subscription.endpoint);
}

function riskClasses(riskTier: ReviewRiskTier) {
  if (riskTier === "critical") {
    return "border-fuchsia-500/35 bg-fuchsia-500/10 text-fuchsia-200";
  }

  if (riskTier === "high") {
    return "border-red-500/35 bg-red-500/10 text-red-200";
  }

  if (riskTier === "medium") {
    return "border-amber-500/35 bg-amber-500/10 text-amber-200";
  }

  return "border-emerald-500/35 bg-emerald-500/10 text-emerald-200";
}

function statusCopy(action: "approve" | "deny") {
  return action === "approve" ? "approved" : "denied";
}

function LongTitleDialog({
  title,
  onClose
}: {
  title: string;
  onClose: () => void;
}) {
  const dialogRef = useRef<HTMLDivElement | null>(null);
  const closeButtonRef = useRef<HTMLButtonElement | null>(null);

  useEffect(() => {
    const previousActive = document.activeElement as HTMLElement | null;
    closeButtonRef.current?.focus();

    const handleKeyDown = (event: KeyboardEvent) => {
      if (event.key === "Escape") {
        event.preventDefault();
        onClose();
        return;
      }

      if (event.key !== "Tab") {
        return;
      }

      const focusable = dialogRef.current?.querySelectorAll<HTMLElement>(
        'button, [href], input, select, textarea, [tabindex]:not([tabindex="-1"])'
      );

      if (!focusable || focusable.length === 0) {
        return;
      }

      const items = [...focusable];
      const first = items[0];
      const last = items[items.length - 1];

      if (event.shiftKey && document.activeElement === first) {
        event.preventDefault();
        last.focus();
      } else if (!event.shiftKey && document.activeElement === last) {
        event.preventDefault();
        first.focus();
      }
    };

    document.addEventListener("keydown", handleKeyDown);

    return () => {
      document.removeEventListener("keydown", handleKeyDown);
      previousActive?.focus();
    };
  }, [onClose]);

  return (
    <motion.div
      initial={{ opacity: 0 }}
      animate={{ opacity: 1 }}
      exit={{ opacity: 0 }}
      className="fixed inset-0 z-50 flex items-end justify-center bg-black/70 px-4 py-6 md:items-center"
      onClick={onClose}
    >
      <motion.div
        ref={dialogRef}
        role="dialog"
        aria-modal="true"
        aria-labelledby="review-title-dialog-heading"
        initial={{ opacity: 0, y: 24 }}
        animate={{ opacity: 1, y: 0 }}
        exit={{ opacity: 0, y: 16 }}
        transition={{ duration: 0.2, ease: "easeOut" }}
        className="w-full max-w-lg rounded-[1.75rem] border border-border bg-card p-6 shadow-2xl shadow-black/50"
        onClick={(event) => event.stopPropagation()}
      >
        <div className="flex items-start justify-between gap-4">
          <div>
            <p className="text-xs uppercase tracking-[0.18em] text-permit">Full pull request title</p>
            <h2 id="review-title-dialog-heading" className="mt-3 text-2xl font-semibold text-signal">
              {title}
            </h2>
          </div>
          <button
            ref={closeButtonRef}
            type="button"
            onClick={onClose}
            className="rounded-full border border-border px-3 py-2 text-xs font-semibold uppercase tracking-[0.12em] text-secondary"
          >
            Close
          </button>
        </div>
      </motion.div>
    </motion.div>
  );
}

function EmptyQueueState() {
  return (
    <div className="rounded-[1.75rem] border border-border bg-card/75 p-8 text-center">
      <div
        aria-hidden="true"
        className="mx-auto flex h-24 w-24 items-center justify-center rounded-full border border-emerald-400/25 bg-emerald-400/10"
      >
        <div className="h-10 w-10 rounded-full border-2 border-dashed border-emerald-300/70" />
      </div>
      <h2 className="mt-5 text-2xl font-semibold text-signal">All clear! No pending requests.</h2>
      <p className="mt-3 text-sm text-secondary">
        Production and staging queues are empty. New approval requests will appear here automatically.
      </p>
    </div>
  );
}

function ErrorState({
  onRetry,
  retrying
}: {
  onRetry: () => void;
  retrying: boolean;
}) {
  return (
    <div className="rounded-[1.75rem] border border-red-500/35 bg-red-500/10 p-6 text-red-50">
      <p className="text-xs uppercase tracking-[0.18em] text-red-200">Queue unavailable</p>
      <h2 className="mt-2 text-2xl font-semibold">We couldn&apos;t load the latest review requests.</h2>
      <p className="mt-3 max-w-2xl text-sm text-red-100/90">
        Check your connection and try again. The queue will keep your previous approvals once it reconnects.
      </p>
      <button type="button" onClick={onRetry} className="btn-secondary mt-5 px-4 py-2 text-sm text-red-50" disabled={retrying}>
        {retrying ? "Retrying..." : "Retry queue"}
      </button>
    </div>
  );
}

export function ReviewDashboard() {
  const prefersReducedMotion = useReducedMotion();
  const router = useRouter();
  const [requests, setRequests] = useState<ReviewRequest[]>([]);
  const [loading, setLoading] = useState(true);
  const [retrying, setRetrying] = useState(false);
  const [error, setError] = useState(false);
  const [permission, setPermission] = useState<NotificationPermission>("default");
  const [permissionState, setPermissionState] = useState<"idle" | "working" | "done" | "error">("idle");
  const [activeTab, setActiveTab] = useState<"pending" | "history">("pending");
  const [activeAction, setActiveAction] = useState<ActionState | null>(null);
  const [statusMessage, setStatusMessage] = useState("Review queue ready.");
  const [titleDialog, setTitleDialog] = useState<string | null>(null);
  const [pullOffset, setPullOffset] = useState(0);
  const initializedRef = useRef(false);
  const statusTimeoutRef = useRef<number | null>(null);
  const actionTimeoutRef = useRef<number | null>(null);
  const pullStartRef = useRef<number | null>(null);
  const pullTrackingRef = useRef(false);

  const announceStatus = (message: string) => {
    setStatusMessage(message);

    if (statusTimeoutRef.current) {
      window.clearTimeout(statusTimeoutRef.current);
    }

    statusTimeoutRef.current = window.setTimeout(() => {
      setStatusMessage("");
    }, 1600);
  };

  const redirectToLogin = () => {
    router.push("/login?reason=session-expired");
  };

  const fetchReviews = async () => {
    const response = await fetch("/api/reviews", { cache: "no-store" });

    if (response.status === 401) {
      redirectToLogin();
      throw new Error("session-expired");
    }

    if (!response.ok) {
      throw new Error("Unable to load review requests.");
    }

    return (await response.json()) as ReviewsResponse;
  };

  const syncQueue = async (mode: "initial" | "retry" | "refresh" = "initial") => {
    if (mode === "retry" || mode === "refresh") {
      setRetrying(true);
    }

    try {
      const data = await fetchReviews();
      setRequests(data.requests);
      setError(false);

      const pendingRequestIds = data.requests.filter((request) => request.status === "pending").map((request) => request.id);
      const seen = new Set<string>(
        JSON.parse(window.localStorage.getItem(SEEN_REQUESTS_KEY) ?? "[]") as string[]
      );

      if (!initializedRef.current) {
        window.localStorage.setItem(SEEN_REQUESTS_KEY, JSON.stringify(pendingRequestIds));
        initializedRef.current = true;
      } else {
        const newRequests = data.requests.filter((request) => request.status === "pending" && !seen.has(request.id));
        newRequests.forEach((request) => seen.add(request.id));
        window.localStorage.setItem(SEEN_REQUESTS_KEY, JSON.stringify([...seen]));

        if (
          "Notification" in window &&
          document.hidden &&
          Notification.permission === "granted" &&
          newRequests.length > 0
        ) {
          const registration = await navigator.serviceWorker.ready;
          await Promise.all(
            newRequests.map((request) =>
              registration.showNotification("Deploy request needs approval", {
                body: `${request.repo} — ${request.prTitle} (${request.riskTier})`,
                icon: "/icons/icon-192.png",
                badge: "/icons/icon-192.png",
                data: { url: `/review?request=${request.id}` }
              })
            )
          );
        }
      }

      if (mode === "refresh") {
        announceStatus("Queue refreshed.");
      }
    } catch (nextError) {
      if (nextError instanceof Error && nextError.message === "session-expired") {
        return;
      }

      setError(true);
      announceStatus("Queue refresh failed.");
    } finally {
      setLoading(false);
      setRetrying(false);
      setPullOffset(0);
    }
  };

  useEffect(() => {
    if (!("Notification" in window)) {
      return;
    }

    setPermission(Notification.permission);
  }, []);

  useEffect(() => {
    void syncQueue();

    const interval = window.setInterval(() => {
      void syncQueue();
    }, 60_000);

    return () => {
      window.clearInterval(interval);

      if (statusTimeoutRef.current) {
        window.clearTimeout(statusTimeoutRef.current);
      }

      if (actionTimeoutRef.current) {
        window.clearTimeout(actionTimeoutRef.current);
      }
    };
  }, []);

  const requestPermission = async () => {
    if (!("Notification" in window)) {
      setPermissionState("error");
      return;
    }

    setPermissionState("working");

    try {
      const nextPermission = await Notification.requestPermission();
      setPermission(nextPermission);

      if (nextPermission !== "granted") {
        setPermissionState("error");
        return;
      }

      await storePushSubscription();
      setPermissionState("done");
    } catch {
      setPermissionState("error");
    }
  };

  const pendingRequests = useMemo(
    () => requests.filter((request) => request.status === "pending"),
    [requests]
  );

  const commitDecision = async (requestId: string, action: "approve" | "deny") => {
    if (activeAction || retrying) {
      return;
    }

    setActiveAction({ id: requestId, action });

    const nextStatus: ReviewStatus = action === "approve" ? "approved" : "denied";
    const decidedAt = new Date().toISOString();

    setRequests((current) =>
      current.map((request) =>
        request.id === requestId
          ? { ...request, status: nextStatus, approver: "Sarah Kim", decidedAt }
          : request
      )
    );

    announceStatus(`Request ${statusCopy(action)}.`);

    await new Promise((resolve) => {
      actionTimeoutRef.current = window.setTimeout(resolve, ACTION_DEBOUNCE_MS);
    });

    setActiveAction(null);
  };

  const handlePullStart = (event: React.TouchEvent<HTMLElement>) => {
    if (activeTab !== "pending" || window.scrollY > 0 || loading || retrying || error) {
      pullTrackingRef.current = false;
      return;
    }

    pullTrackingRef.current = true;
    pullStartRef.current = event.touches[0].clientY;
  };

  const handlePullMove = (event: React.TouchEvent<HTMLElement>) => {
    if (!pullTrackingRef.current || pullStartRef.current === null) {
      return;
    }

    const delta = event.touches[0].clientY - pullStartRef.current;

    if (delta <= 0) {
      setPullOffset(0);
      return;
    }

    const rubberBand = Math.min(96, delta * 0.45);
    setPullOffset(rubberBand);
  };

  const handlePullEnd = () => {
    if (!pullTrackingRef.current) {
      return;
    }

    pullTrackingRef.current = false;
    pullStartRef.current = null;

    if (pullOffset > 72) {
      void syncQueue("refresh");
      return;
    }

    setPullOffset(0);
  };

  const tabContent = activeTab === "pending"
    ? (
        <motion.section
          key="pending"
          initial={prefersReducedMotion ? false : { opacity: 0 }}
          animate={{ opacity: 1 }}
          exit={prefersReducedMotion ? { opacity: 0 } : { opacity: 0 }}
          transition={{ duration: prefersReducedMotion ? 0.12 : 0.2 }}
          className="mt-6 grid gap-4"
        >
          <motion.div
            animate={{ height: pullOffset, opacity: pullOffset > 0 ? 1 : 0 }}
            transition={{ type: "spring", stiffness: 240, damping: 26 }}
            className="overflow-hidden"
            aria-hidden="true"
          >
            <div className="flex h-full items-end justify-center pb-2 text-xs uppercase tracking-[0.18em] text-secondary">
              {retrying ? "Refreshing queue..." : pullOffset > 72 ? "Release to refresh" : "Pull to refresh"}
            </div>
          </motion.div>

          {loading ? (
            <div className="rounded-[1.75rem] border border-border bg-card/75 p-6 text-secondary">
              Loading pending requests...
            </div>
          ) : null}

          {!loading && error ? <ErrorState onRetry={() => void syncQueue("retry")} retrying={retrying} /> : null}

          {!loading && !error && pendingRequests.length === 0 ? <EmptyQueueState /> : null}

          <AnimatePresence initial={false}>
            {!loading && !error
              ? pendingRequests.map((request, index) => {
                  const isWorking = activeAction?.id === request.id;

                  return (
                    <motion.div
                      key={request.id}
                      layout
                      exit={prefersReducedMotion ? { opacity: 0 } : { opacity: 0, x: 36, y: -10 }}
                      transition={{ duration: prefersReducedMotion ? 0.12 : 0.24, ease: "easeOut" }}
                    >
                      <SwipeableCard
                        index={index}
                        disabled={isWorking}
                        onSwipeAction={(direction) => commitDecision(request.id, direction === "right" ? "approve" : "deny")}
                      >
                        <article className="rounded-[1.75rem] border border-border bg-card/80 p-5">
                          <div className="flex flex-col gap-4 md:flex-row md:items-start md:justify-between">
                            <div className="min-w-0">
                              <div className="flex flex-wrap items-center gap-2">
                                <span className="rounded-full border border-border bg-ash/70 px-3 py-1 text-[11px] uppercase tracking-[0.16em] text-secondary">
                                  {request.repo}
                                </span>
                                <span
                                  className={`rounded-full border px-3 py-1 text-[11px] uppercase tracking-[0.16em] ${riskClasses(request.riskTier)}`}
                                >
                                  {request.riskTier} risk
                                </span>
                              </div>
                              <button
                                type="button"
                                title={request.prTitle}
                                onClick={() => setTitleDialog(request.prTitle)}
                                onContextMenu={(event) => {
                                  event.preventDefault();
                                  setTitleDialog(request.prTitle);
                                }}
                                className="mt-3 block max-w-2xl text-left text-2xl font-semibold text-signal"
                                style={{
                                  display: "-webkit-box",
                                  WebkitBoxOrient: "vertical",
                                  WebkitLineClamp: 2,
                                  overflow: "hidden"
                                }}
                              >
                                {request.prTitle}
                              </button>
                              <p className="mt-2 max-w-2xl text-sm text-secondary">{request.summary}</p>
                            </div>
                            <div className="rounded-2xl border border-border bg-ash/60 px-4 py-3 text-sm text-secondary">
                              <p>
                                Env: <span className="font-medium text-signal">{request.environment}</span>
                              </p>
                              <p className="mt-1">
                                Actor: <span className="font-medium text-signal">{request.author}</span>
                              </p>
                            </div>
                          </div>
                          <div className="mt-5 flex flex-wrap items-center gap-3">
                            <button
                              type="button"
                              className="btn-primary px-4 py-2 text-sm"
                              onClick={() => void commitDecision(request.id, "approve")}
                              disabled={isWorking}
                              aria-label={`Approve pull request ${request.prTitle}`}
                            >
                              {isWorking && activeAction?.action === "approve" ? "Approving..." : "Approve"}
                            </button>
                            <button
                              type="button"
                              className="btn-secondary px-4 py-2 text-sm"
                              onClick={() => void commitDecision(request.id, "deny")}
                              disabled={isWorking}
                              aria-label={`Deny pull request ${request.prTitle}`}
                            >
                              {isWorking && activeAction?.action === "deny" ? "Denying..." : "Deny"}
                            </button>
                            <Link href={`/review?request=${request.id}`} className="text-sm font-semibold text-permit">
                              Open review
                            </Link>
                          </div>
                        </article>
                      </SwipeableCard>
                    </motion.div>
                  );
                })
              : null}
          </AnimatePresence>
        </motion.section>
      )
    : (
        <motion.section
          key="history"
          initial={prefersReducedMotion ? false : { opacity: 0 }}
          animate={{ opacity: 1 }}
          exit={prefersReducedMotion ? { opacity: 0 } : { opacity: 0 }}
          transition={{ duration: prefersReducedMotion ? 0.12 : 0.2 }}
          className="mt-6"
        >
          <DeployHistory requests={requests} />
        </motion.section>
      );

  return (
    <div
      className="section-shell pb-16 pt-28"
      onTouchStart={handlePullStart}
      onTouchMove={handlePullMove}
      onTouchEnd={handlePullEnd}
      onTouchCancel={handlePullEnd}
    >
      <div className="mx-auto max-w-5xl">
        <div aria-live="polite" aria-atomic="true" className="sr-only">
          {statusMessage}
        </div>

        <div className="flex flex-col gap-4 rounded-[2rem] border border-border bg-card/80 p-6 shadow-2xl shadow-black/20">
          <p className="text-xs uppercase tracking-[0.2em] text-permit">Mobile Review Queue</p>
          <div className="flex flex-col gap-3 md:flex-row md:items-end md:justify-between">
            <div>
              <h1 className="text-4xl font-semibold text-signal">Deploy approvals, ready for home screen.</h1>
              <p className="mt-3 max-w-2xl text-sm text-secondary">
                Cached review queue, local approval alerts, and a standalone install path for mobile responders.
              </p>
            </div>
            <div className="rounded-2xl border border-border bg-ash/70 px-4 py-3 text-sm text-secondary">
              Polling <span className="font-medium text-signal">/api/reviews</span> every 60 seconds
            </div>
          </div>
        </div>

        {permission !== "granted" ? (
          <section className="mt-6 rounded-[1.75rem] border border-permit/35 bg-permit/10 p-5">
            <p className="text-xs uppercase tracking-[0.18em] text-permit">Notifications</p>
            <h2 className="mt-2 text-2xl font-semibold text-signal">
              Get notified when deploy requests need your approval?
            </h2>
            <p className="mt-3 max-w-2xl text-sm text-secondary">
              Permission Protocol stores the local push subscription endpoint on this device for the Phase 3 MVP.
            </p>
            <div className="mt-4 flex flex-wrap items-center gap-3">
              <button type="button" onClick={() => void requestPermission()} className="btn-primary px-4 py-2 text-sm">
                {permissionState === "working" ? "Requesting..." : "Enable notifications"}
              </button>
              <p className="text-xs text-secondary">
                {permissionState === "done"
                  ? "Notifications enabled for this device."
                  : permissionState === "error"
                    ? "Notifications were not enabled. You can retry from this screen."
                    : "Android Chrome and iOS 16.4+ Safari support web push."}
              </p>
            </div>
          </section>
        ) : null}

        <div className="mt-6">
          <div
            role="tablist"
            aria-label="Review dashboard views"
            className="inline-flex rounded-2xl border border-border bg-card p-1"
          >
            <button
              type="button"
              role="tab"
              aria-selected={activeTab === "pending"}
              onClick={() => setActiveTab("pending")}
              className={`rounded-[0.9rem] px-4 py-2 text-sm font-medium ${
                activeTab === "pending" ? "bg-permit/20 text-permit" : "text-secondary hover:bg-ash hover:text-signal"
              }`}
            >
              Pending ({pendingRequests.length})
            </button>
            <button
              type="button"
              role="tab"
              aria-selected={activeTab === "history"}
              onClick={() => setActiveTab("history")}
              className={`rounded-[0.9rem] px-4 py-2 text-sm font-medium ${
                activeTab === "history" ? "bg-permit/20 text-permit" : "text-secondary hover:bg-ash hover:text-signal"
              }`}
            >
              History
            </button>
          </div>
        </div>

        <AnimatePresence mode="wait" initial={false}>
          {tabContent}
        </AnimatePresence>
      </div>

      <AnimatePresence>{titleDialog ? <LongTitleDialog title={titleDialog} onClose={() => setTitleDialog(null)} /> : null}</AnimatePresence>
    </div>
  );
}
