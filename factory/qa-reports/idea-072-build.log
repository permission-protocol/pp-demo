--- /dev/null
+++ b/src/components/SwipeableCard.tsx
@@ -0,0 +1,195 @@
+"use client";
+
+import { useEffect, useMemo, useRef, useState } from "react";
+import { motion, useReducedMotion } from "framer-motion";
+
+type SwipeDirection = "left" | "right";
+
+type SwipeableCardProps = {
+  children: React.ReactNode;
+  disabled?: boolean;
+  index?: number;
+  onSwipeAction: (direction: SwipeDirection) => Promise<void> | void;
+};
+
+const ACTION_THRESHOLD = 0.4;
+
+function isTouchDevice() {
+  if (typeof window === "undefined") {
+    return false;
+  }
+
+  return window.matchMedia("(pointer: coarse)").matches || navigator.maxTouchPoints > 0;
+}
+
+export function SwipeableCard({ children, disabled = false, index = 0, onSwipeAction }: SwipeableCardProps) {
+  const prefersReducedMotion = useReducedMotion();
+  const containerRef = useRef<HTMLDivElement | null>(null);
+  const touchEnabledRef = useRef(false);
+  const thresholdReachedRef = useRef<SwipeDirection | null>(null);
+  const startXRef = useRef(0);
+  const startYRef = useRef(0);
+  const draggingRef = useRef(false);
+  const [dragOffset, setDragOffset] = useState(0);
+  const [leavingDirection, setLeavingDirection] = useState<SwipeDirection | null>(null);
+  const [isAnimatingOut, setIsAnimatingOut] = useState(false);
+
+  useEffect(() => {
+    touchEnabledRef.current = isTouchDevice();
+  }, []);
+
+  const backgroundClassName = useMemo(() => {
+    if (dragOffset === 0) {
+      return "bg-card/80";
+    }
+
+    return dragOffset > 0 ? "bg-emerald-500/16" : "bg-red-500/16";
+  }, [dragOffset]);
+
+  const revealStyle = useMemo(() => {
+    const width = containerRef.current?.offsetWidth ?? 1;
+    const progress = Math.min(Math.abs(dragOffset) / width, 1);
+
+    return {
+      opacity: progress,
+      transform: `scale(${0.96 + progress * 0.04})`
+    };
+  }, [dragOffset]);
+
+  const triggerHaptic = (duration: number) => {
+    if (typeof navigator === "undefined" || typeof navigator.vibrate !== "function") {
+      return;
+    }
+
+    navigator.vibrate(duration);
+  };
+
+  const handleTouchStart = (event: React.TouchEvent<HTMLDivElement>) => {
+    if (!touchEnabledRef.current || disabled || isAnimatingOut) {
+      return;
+    }
+
+    const touch = event.touches[0];
+    startXRef.current = touch.clientX;
+    startYRef.current = touch.clientY;
+    draggingRef.current = true;
+    thresholdReachedRef.current = null;
+  };
+
+  const handleTouchMove = (event: React.TouchEvent<HTMLDivElement>) => {
+    if (!draggingRef.current || !touchEnabledRef.current || disabled || isAnimatingOut) {
+      return;
+    }
+
+    const touch = event.touches[0];
+    const deltaX = touch.clientX - startXRef.current;
+    const deltaY = touch.clientY - startYRef.current;
+
+    if (Math.abs(deltaY) > Math.abs(deltaX)) {
+      setDragOffset(0);
+      return;
+    }
+
+    event.preventDefault();
+
+    const width = containerRef.current?.offsetWidth ?? 1;
+    const threshold = width * ACTION_THRESHOLD;
+    const nextDirection: SwipeDirection | null =
+      deltaX >= threshold ? "right" : deltaX <= -threshold ? "left" : null;
+
+    if (nextDirection !== null && thresholdReachedRef.current !== nextDirection) {
+      thresholdReachedRef.current = nextDirection;
+      triggerHaptic(10);
+    }
+
+    if (nextDirection === null) {
+      thresholdReachedRef.current = null;
+    }
+
+    setDragOffset(deltaX);
+  };
+
+  const resetCard = () => {
+    draggingRef.current = false;
+    thresholdReachedRef.current = null;
+    setDragOffset(0);
+  };
+
+  const handleTouchEnd = async () => {
+    if (!draggingRef.current || disabled || isAnimatingOut) {
+      return;
+    }
+
+    draggingRef.current = false;
+
+    const width = containerRef.current?.offsetWidth ?? 1;
+    const threshold = width * ACTION_THRESHOLD;
+
+    if (Math.abs(dragOffset) < threshold) {
+      setDragOffset(0);
+      thresholdReachedRef.current = null;
+      return;
+    }
+
+    const direction: SwipeDirection = dragOffset > 0 ? "right" : "left";
+
+    setLeavingDirection(direction);
+    setIsAnimatingOut(true);
+    triggerHaptic(25);
+
+    await onSwipeAction(direction);
+
+    setDragOffset(0);
+    thresholdReachedRef.current = null;
+  };
+
+  return (
+    <motion.div
+      ref={containerRef}
+      initial={prefersReducedMotion ? false : { opacity: 0, y: 20 }}
+      animate={
+        isAnimatingOut
+          ? {
+              opacity: 0,
+              x: leavingDirection === "right" ? "120%" : "-120%",
+              y: 0
+            }
+          : {
+              opacity: 1,
+              x: dragOffset,
+              y: 0
+            }
+      }
+      exit={prefersReducedMotion ? { opacity: 0 } : { opacity: 0, y: -12 }}
+      transition={
+        isAnimatingOut
+          ? { duration: prefersReducedMotion ? 0.12 : 0.24, ease: "easeOut" }
+          : {
+              delay: prefersReducedMotion ? 0 : index * 0.05,
+              duration: prefersReducedMotion ? 0.12 : 0.28,
+              ease: "easeOut"
+            }
+      }
+      className="relative overflow-hidden rounded-[1.75rem]"
+      onTouchStart={handleTouchStart}
+      onTouchMove={handleTouchMove}
+      onTouchEnd={() => {
+        void handleTouchEnd();
+      }}
+      onTouchCancel={resetCard}
+      style={{ touchAction: touchEnabledRef.current ? "pan-y" : "auto" }}
+    >
+      <div className={`absolute inset-0 transition-colors duration-200 ${backgroundClassName}`} aria-hidden="true">
+        <div
+          className={`absolute inset-y-0 flex items-center px-5 text-xs font-semibold uppercase tracking-[0.18em] text-white ${
+            dragOffset >= 0 ? "left-0 justify-start" : "right-0 justify-end"
+          }`}
+          style={revealStyle}
+        >
+          {dragOffset >= 0 ? "Approve" : "Deny"}
+        </div>
+      </div>
+      <div className="relative">{children}</div>
+    </motion.div>
+  );
+}


