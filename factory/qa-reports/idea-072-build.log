+type LoginPageProps = {
+  searchParams?: {
+    reason?: string;
+  };
+};
+
+export default function LoginPage({ searchParams }: LoginPageProps) {
+  const sessionExpired = searchParams?.reason === "session-expired";
+
+  return (
+    <div className="section-shell pb-16 pt-28">
+      <div className="mx-auto max-w-xl rounded-[2rem] border border-border bg-card/85 p-8 shadow-2xl shadow-black/25">
+        <p className="text-xs uppercase tracking-[0.18em] text-permit">Reviewer login</p>
+        <h1 className="mt-3 text-4xl font-semibold text-signal">Sign back in to continue reviewing.</h1>
+        <p className="mt-4 text-sm text-secondary">
+          {sessionExpired
+            ? "Session expired. Authenticate again to reload the approval queue."
+            : "Authenticate to access the mobile deploy review queue."}
+        </p>
+        <div className="mt-6 rounded-[1.5rem] border border-border bg-ash/70 p-5 text-sm text-secondary">
+          This demo workspace does not include a live auth provider, so this page acts as the redirect target for expired
+          dashboard sessions.
+        </div>
+      </div>
+    </div>
+  );
+}
