+
+function EndpointCard({ endpoint }: { endpoint: EndpointDoc }) {
+  return (
+    <article
+      id={endpoint.id}
+      className="scroll-mt-28 rounded-2xl border border-border bg-ash/75 p-6 shadow-[0_18px_60px_rgba(0,0,0,0.25)]"
