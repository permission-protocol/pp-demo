+"use client";
+
+import Link from "next/link";
+import { useEffect, useState } from "react";
+import { CodeBlock } from "@/src/components/CodeBlock";
+
+type StatusCode = {
+  code: number;
+  meaning: string;
+};
+
+type EndpointDoc = {
+  id: string;
+  method: "GET" | "POST";
+  path: string;
+  title: string;
+  description: string;
+  authentication: string;
+  requestBody?: string;
+  responseBody: string;
+  statusCodes: StatusCode[];
+};
+
+const sections = [
+  { id: "overview", label: "Overview" },
+  { id: "authentication", label: "Authentication" },
+  { id: "endpoints", label: "Endpoints" },
+  { id: "rate-limits", label: "Rate Limits" },
+  { id: "examples", label: "Examples" }
+] as const;
+
+const endpointDocs: EndpointDoc[] = [
+  {
+    id: "list-review-requests",
+    method: "GET",
+    path: "/api/reviews",
+    title: "List deploy requests",
+    description: "Returns the current deploy review queue with status, author, branch, and summary metadata.",
+    authentication: "Accepts API key or authenticated dashboard session.",
+    responseBody: `{
+  "requests": [
+    {
+      "id": "req_7f3d9a2c",
+      "status": "pending",
+      "repo": "permission-protocol/site",
+      "prNumber": 214,
+      "prTitle": "Harden production deploy gate",
+      "author": "marco",
+      "branch": "marco/deploy-gate-hardening",
+      "summary": "Touches receipt verification and production policy enforcement."
+    }
+  ],
+  "generatedAt": "2025-01-18T18:42:11.224Z"
+}`,
+    statusCodes: [
+      { code: 200, meaning: "Queue returned successfully." },
+      { code: 401, meaning: "Missing or invalid credentials." },
+      { code: 429, meaning: "Too many polling requests." }
+    ]
+  },
+  {
+    id: "get-review-request",
