+import { beforeEach, describe, expect, it, vi } from "vitest";
+import { renderToStaticMarkup } from "react-dom/server";
+
+const notFound = vi.fn(() => {
+  throw new Error("NEXT_NOT_FOUND");
+});
+
+const getPublicReceiptView = vi.fn();
+
+vi.mock("next/navigation", () => ({
+  notFound,
+}));
+
+vi.mock("@/lib/public-receipts", async () => {
+  const actual = await vi.importActual<typeof import("@/lib/public-receipts")>("@/lib/public-receipts");
+  return {
+    ...actual,
+    getPublicReceiptView,
+  };
+});
+
+describe("public receipt page", () => {
+  beforeEach(() => {
+    vi.clearAllMocks();
+  });
+
+  it("renders the hardcoded demo receipt without a DB lookup", async () => {
+    const { default: ReceiptPage } = await import("@/app/r/[id]/page");
+    const page = await ReceiptPage({ params: { id: "demo" } });
+    const html = renderToStaticMarkup(page);
+
+    expect(getPublicReceiptView).not.toHaveBeenCalled();
+    expect(html).toContain("deploy → billing-service");
+    expect(html).toContain("deploy-bot");
+    expect(html).toContain("Sarah Kim");
+    expect(html).toContain("production-deploy");
+    expect(html).toContain("Verified ✓");
+    expect(html).toContain("permissionprotocol.com/r/demo");
+  });
+
+  it("looks up real receipts for non-demo ids", async () => {
+    getPublicReceiptView.mockResolvedValue({
+      receipt_id: "rcpt_live_123",
+      status: "AUTHORIZED",
+      action: "deploy",
+      resource: "production",
+      actor: "deploy-bot",
+      approved_by: "release-manager",
+      approved_by_avatar: null,
+      approved_by_url: null,
+      policy: "production-deploy",
+      risk_tier: "PRODUCTION",
+      summary: "Authorized deployment.",
+      timestamp: "2026-03-01T10:00:00.000Z",
+      expires_at: null,
+      signature: {
+        algorithm: "ed25519",
+        key_id: "key-live",
+        value: "abcdef...",
+        verified: true,
+      },
+      issuer: "permissionprotocol.com",
+      receipt_version: 1,
+      url: "https://permissionprotocol.com/r/rcpt_live_123",
+    });
+
+    const { default: ReceiptPage } = await import("@/app/r/[id]/page");
+    const page = await ReceiptPage({ params: { id: "rcpt_live_123" } });
+    const html = renderToStaticMarkup(page);
+
+    expect(getPublicReceiptView).toHaveBeenCalledWith("rcpt_live_123");
+    expect(html).toContain("release-manager");
+    expect(html).toContain("permissionprotocol.com/r/rcpt_live_123");
+  });
+
+  it("returns not found when a real receipt does not exist", async () => {
+    getPublicReceiptView.mockResolvedValue(null);
+
+    const { default: ReceiptPage } = await import("@/app/r/[id]/page");
+
+    await expect(ReceiptPage({ params: { id: "missing" } })).rejects.toThrow("NEXT_NOT_FOUND");
+    expect(notFound).toHaveBeenCalledTimes(1);
+  });
+});

