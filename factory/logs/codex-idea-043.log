+import { buildDemoPublicReceipt, getPublicReceiptView, type PublicReceiptView } from "@/lib/public-receipts";
+
+export const dynamic = "force-dynamic";
+
+function formatTimestamp(timestamp: string): string {
+  return new Intl.DateTimeFormat("en-US", {
+    dateStyle: "medium",
+    timeStyle: "short",
+  }).format(new Date(timestamp));
+}
+
+function renderValue(value: string | null, fallback = "Not available") {
+  return value ?? fallback;
+}
+
+function ReceiptField({
+  label,
+  value,
+  mono = false,
+  href,
+}: {
+  label: string;
+  value: string;
+  mono?: boolean;
+  href?: string | null;
+}) {
+  const className = mono
+    ? "font-['JetBrains_Mono'] text-sm text-[var(--foreground)] break-all"
+    : "text-base font-medium text-[var(--foreground)]";
+
+  return (
+    <div className="rounded-2xl border border-[var(--border)] bg-black/10 p-4">
+      <dt className="mb-2 text-xs uppercase tracking-[0.22em] text-[var(--muted)]">{label}</dt>
+      <dd className={className}>
+        {href ? (
+          <Link className="text-[var(--accent-blue)] hover:underline" href={href}>
+            {value}
+          </Link>
+        ) : (
+          value
+        )}
+      </dd>
+    </div>
+  );
+}
+
+function ReceiptView({ receipt, receiptUrlLabel }: { receipt: PublicReceiptView; receiptUrlLabel: string }) {
+  const actionLabel =
+    receipt.action && receipt.resource ? `${receipt.action} → ${receipt.resource}` : renderValue(receipt.action);
+  const signatureLabel = receipt.signature.verified ? "Verified ✓" : "Unavailable";
+
+  return (
+    <main className="min-h-screen bg-[radial-gradient(circle_at_top,_rgba(88,166,255,0.18),_transparent_35%),linear-gradient(180deg,_#0d1117_0%,_#090c10_100%)] px-6 py-12 text-[var(--foreground)]">
+      <div className="mx-auto max-w-5xl">
+        <div className="glass overflow-hidden rounded-[28px] border border-[var(--border)] shadow-[0_30px_100px_rgba(0,0,0,0.45)]">
+          <div className="border-b border-[var(--border)] bg-white/[0.03] px-6 py-5 sm:px-8">
+            <div className="flex flex-col gap-4 sm:flex-row sm:items-start sm:justify-between">
+              <div>
+                <p className="mb-2 text-xs uppercase tracking-[0.28em] text-[var(--accent-blue)]">Permission Receipt</p>
+                <h1 className="text-3xl font-semibold sm:text-4xl">Who authorized that AI action?</h1>
+                <p className="mt-3 max-w-2xl text-sm text-[var(--muted)] sm:text-base">
+                  Verifiable proof that the action was reviewed, approved, and signed before execution.
+                </p>
+              </div>
+              <div className="flex items-center gap-2 self-start rounded-full border border-emerald-400/30 bg-emerald-400/10 px-3 py-1.5 text-sm font-medium text-emerald-300">
+                <span className="h-2 w-2 rounded-full bg-emerald-400" />
+                {signatureLabel}
+              </div>
+            </div>
+          </div>
+
+          <div className="grid gap-6 px-6 py-6 sm:px-8 lg:grid-cols-[1.35fr_0.95fr]">
+            <section className="space-y-6">
+              <div className="rounded-[24px] border border-[var(--border)] bg-[linear-gradient(135deg,rgba(88,166,255,0.18),rgba(22,27,34,0.35))] p-6">
+                <p className="text-sm uppercase tracking-[0.2em] text-[var(--muted)]">Authorized Action</p>
+                <p className="mt-3 text-3xl font-semibold sm:text-4xl">{actionLabel}</p>
+                <div className="mt-6 flex flex-wrap gap-3 text-sm text-[var(--muted)]">
+                  <span className="rounded-full border border-[var(--border)] px-3 py-1">{receipt.status}</span>
+                  <span className="rounded-full border border-[var(--border)] px-3 py-1">
+                    {renderValue(receipt.policy)}
+                  </span>
+                  <span className="rounded-full border border-[var(--border)] px-3 py-1">
+                    {renderValue(receipt.resource)}
+                  </span>
+                </div>
+              </div>
+
+              <dl className="grid gap-4 sm:grid-cols-2">
+                <ReceiptField label="Action" value={actionLabel} />
+                <ReceiptField label="Agent" value={receipt.actor} />
+                <ReceiptField label="Approved By" value={renderValue(receipt.approved_by)} />
+                <ReceiptField label="Policy" value={renderValue(receipt.policy)} />
+                <ReceiptField label="Timestamp" value={formatTimestamp(receipt.timestamp)} />
+                <ReceiptField label="Environment" value={renderValue(receipt.resource)} />
+                <ReceiptField label="Signature" value={signatureLabel} />
+                <ReceiptField
+                  label="Receipt URL"
+                  value={receiptUrlLabel}
+                  mono
+                  href={receipt.url}
+                />
+              </dl>
+            </section>
+
+            <aside className="space-y-4">
+              <div className="rounded-[24px] border border-[var(--border)] bg-white/[0.03] p-5">
+                <p className="text-xs uppercase tracking-[0.22em] text-[var(--muted)]">Proof Summary</p>
+                <p className="mt-3 text-sm leading-6 text-[var(--foreground)]">
+                  {receipt.summary ?? "This action has a signed receipt proving authority existed at execution time."}
+                </p>
+              </div>
+              <div className="rounded-[24px] border border-[var(--border)] bg-white/[0.03] p-5">
+                <p className="text-xs uppercase tracking-[0.22em] text-[var(--muted)]">Receipt Metadata</p>
+                <dl className="mt-4 space-y-3 text-sm">
+                  <div className="flex items-start justify-between gap-4">
+                    <dt className="text-[var(--muted)]">Receipt ID</dt>
+                    <dd className="font-['JetBrains_Mono'] text-right">{receipt.receipt_id}</dd>
+                  </div>
+                  <div className="flex items-start justify-between gap-4">
+                    <dt className="text-[var(--muted)]">Issuer</dt>
+                    <dd>{receipt.issuer}</dd>
+                  </div>
+                  <div className="flex items-start justify-between gap-4">
+                    <dt className="text-[var(--muted)]">Signature Key</dt>
+                    <dd className="font-['JetBrains_Mono'] text-right">{renderValue(receipt.signature.key_id)}</dd>
+                  </div>
+                  <div className="flex items-start justify-between gap-4">
+                    <dt className="text-[var(--muted)]">Algorithm</dt>
+                    <dd>{renderValue(receipt.signature.algorithm)}</dd>
+                  </div>
+                </dl>
+              </div>
+            </aside>
+          </div>
+        </div>
+      </div>
+    </main>
+  );
+}
+
+export default async function ReceiptPage({ params }: { params: { id: string } }) {
+  const receipt = params.id === "demo" ? buildDemoPublicReceipt() : await getPublicReceiptView(params.id);
+
+  if (!receipt) {
+    notFound();
+  }
+
+  const receiptUrlLabel = receipt.receipt_id === "demo" ? "permissionprotocol.com/r/demo" : receipt.url.replace(/^https?:\/\//, "");
+
+  return <ReceiptView receipt={receipt} receiptUrlLabel={receiptUrlLabel} />;
+}
