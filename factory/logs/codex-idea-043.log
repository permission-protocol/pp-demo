    <main className="min-h-screen bg-[radial-gradient(circle_at_top,_rgba(88,166,255,0.18),_transparent_35%),linear-gradient(180deg,_#0d1117_0%,_#090c10_100%)] px-6 py-12 text-[var(--foreground)]">
