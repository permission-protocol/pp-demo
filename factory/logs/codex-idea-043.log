const DEPLOY_GATE_RECEIPT_PREFIX = "rcpt_dg_";

export function normalizePublicReceiptId(receiptId: string): string {
  if (!receiptId.startsWith(DEPLOY_GATE_RECEIPT_PREFIX)) {
    return receiptId;
  }

  return receiptId.slice(DEPLOY_GATE_RECEIPT_PREFIX.length);
}
