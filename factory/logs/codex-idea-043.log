@@ -0,0 +1,168 @@
+import { rawPrisma as prisma } from "@/lib/company/raw-prisma";
+import { normalizePublicReceiptId } from "@/lib/receiptData";
+
+export interface PublicReceiptView {
+  receipt_id: string;
+  status: string;
+  action: string | null;
+  resource: string | null;
+  actor: string;
+  approved_by: string | null;
+  approved_by_avatar: string | null;
+  approved_by_url: string | null;
+  policy: string | null;
+  risk_tier: string | null;
+  summary: string | null;
+  timestamp: string;
+  expires_at: string | null;
+  signature: {
+    algorithm: string | null;
+    key_id: string | null;
+    value: string | null;
+    verified: boolean;
+  };
+  issuer: string;
+  receipt_version: number;
+  url: string;
+}
+
+function extractActionFields(requestJson: string | null): {
+  action: string | null;
+  resource: string | null;
+} {
+  if (!requestJson) return { action: null, resource: null };
+
+  try {
+    const parsed = JSON.parse(requestJson);
+    return {
+      action: parsed.action?.tool || parsed.action?.operation || parsed.intent?.name || null,
+      resource: parsed.action?.resource || parsed.context?.environment || null,
+    };
+  } catch {
+    return { action: null, resource: null };
+  }
+}
+
+function extractDeployRequestId(requestJson: string | null): string | null {
+  if (!requestJson) return null;
+
+  try {
+    const parsed = JSON.parse(requestJson);
+    const requestId = parsed?.metadata?.deployGateRequestId;
+    return typeof requestId === "string" ? requestId : null;
+  } catch {
+    return null;
+  }
+}
+
+export function buildDemoPublicReceipt(now: Date = new Date()): PublicReceiptView {
+  const timestamp = new Date(now.getTime() - 2 * 60 * 60 * 1000).toISOString();
+
+  return {
+    receipt_id: "demo",
+    status: "AUTHORIZED",
+    action: "deploy",
+    resource: "billing-service",
+    actor: "deploy-bot",
+    approved_by: "Sarah Kim",
+    approved_by_avatar: null,
+    approved_by_url: null,
+    policy: "production-deploy",
+    risk_tier: "PRODUCTION",
+    summary: "Production deploy authorized and verified before execution.",
+    timestamp,
+    expires_at: null,
+    signature: {
+      algorithm: "ed25519",
+      key_id: "pp_demo_key",
+      value: "Verified ✓",
+      verified: true,
+    },
+    issuer: "permissionprotocol.com",
+    receipt_version: 1,
+    url: "https://permissionprotocol.com/r/demo",
+  };
+}
+
+export async function getPublicReceiptView(receiptId: string): Promise<PublicReceiptView | null> {
+  const normalizedReceiptId = normalizePublicReceiptId(receiptId);
+
+  if (
+    !normalizedReceiptId ||
+    normalizedReceiptId.length > 100 ||
+    !/^[a-zA-Z0-9_-]+$/.test(normalizedReceiptId)
+  ) {
+    return null;
+  }
+
+  const receipt = await prisma.permissionReceipt.findUnique({
+    where: { id: normalizedReceiptId },
+    select: {
+      id: true,
+      status: true,
+      agentId: true,
+      requestJson: true,
+      riskTier: true,
+      policyVersion: true,
+      summary: true,
+      receiptVersion: true,
+      signatureAlg: true,
+      signatureKeyId: true,
+      signatureValue: true,
+      expiresAt: true,
+      createdAt: true,
+    },
+  });
+
+  if (!receipt) {
+    return null;
+  }
+
+  const { action, resource } = extractActionFields(receipt.requestJson);
+  const deployGateRequestId = extractDeployRequestId(receipt.requestJson);
+  const deployRequest = deployGateRequestId
+    ? await prisma.deployGateRequest.findUnique({
+        where: { id: deployGateRequestId },
+        select: {
+          approvedBy: true,
+          approvedByAvatar: true,
+        },
+      })
+    : null;
+
+  const statusMap: Record<string, string> = {
+    APPROVED: "AUTHORIZED",
+    DENIED: "DENIED",
+    EXPIRED: "EXPIRED",
+    PENDING_DECISION: "PENDING",
+    REQUIRES_APPROVAL: "AWAITING_APPROVAL",
+    REQUIRES_FOUNDER_VETO: "AWAITING_APPROVAL",
+    EXECUTING: "EXECUTING",
+    ERROR: "ERROR",
+  };
+
+  return {
+    receipt_id: receipt.id,
+    status: statusMap[receipt.status] || receipt.status,
+    action,
+    resource,
+    actor: receipt.agentId,
+    approved_by: deployRequest?.approvedBy ?? null,
+    approved_by_avatar: deployRequest?.approvedByAvatar ?? null,
+    approved_by_url: deployRequest?.approvedBy ? `https://github.com/${deployRequest.approvedBy}` : null,
+    policy: receipt.policyVersion,
+    risk_tier: receipt.riskTier,
+    summary: receipt.summary,
+    timestamp: receipt.createdAt.toISOString(),
+    expires_at: receipt.expiresAt?.toISOString() || null,
+    signature: {
+      algorithm: receipt.signatureAlg,
+      key_id: receipt.signatureKeyId,
+      value: receipt.signatureValue ? `${receipt.signatureValue.slice(0, 12)}...` : null,
+      verified: !!receipt.signatureValue,
+    },
+    issuer: "permissionprotocol.com",
+    receipt_version: receipt.receiptVersion,
+    url: `https://permissionprotocol.com/r/${receipt.id}`,
+  };
+}
