import Link from "next/link";
import { notFound } from "next/navigation";
import { buildDemoPublicReceipt, getPublicReceiptView, type PublicReceiptView } from "@/lib/public-receipts";

export const dynamic = "force-dynamic";

function formatTimestamp(timestamp: string): string {
  return new Intl.DateTimeFormat("en-US", {
    dateStyle: "medium",
    timeStyle: "short",
  }).format(new Date(timestamp));
}

function renderValue(value: string | null, fallback = "Not available") {
  return value ?? fallback;
}

function ReceiptField({
  label,
  value,
  mono = false,
  href,
}: {
  label: string;
  value: string;
  mono?: boolean;
  href?: string | null;
}) {
  const className = mono
    ? "font-['JetBrains_Mono'] text-sm text-[var(--foreground)] break-all"
    : "text-base font-medium text-[var(--foreground)]";

  return (
    <div className="rounded-2xl border border-[var(--border)] bg-black/10 p-4">
      <dt className="mb-2 text-xs uppercase tracking-[0.22em] text-[var(--muted)]">{label}</dt>
      <dd className={className}>
        {href ? (
          <Link className="text-[var(--accent-blue)] hover:underline" href={href}>
            {value}
          </Link>
        ) : (
          value
        )}
      </dd>
    </div>
  );
}

function ReceiptView({ receipt, receiptUrlLabel }: { receipt: PublicReceiptView; receiptUrlLabel: string }) {
  const actionLabel =
    receipt.action && receipt.resource ? `${receipt.action} → ${receipt.resource}` : renderValue(receipt.action);
  const signatureLabel = receipt.signature.verified ? "Verified ✓" : "Unavailable";

