+import { rawPrisma as prisma } from "@/lib/company/raw-prisma";
+import { normalizePublicReceiptId } from "@/lib/receiptData";
+
+export interface PublicReceiptView {
+  receipt_id: string;
+  status: string;
+  action: string | null;
+  resource: string | null;
+  actor: string;
+  approved_by: string | null;
+  approved_by_avatar: string | null;
+  approved_by_url: string | null;
+  policy: string | null;
+  risk_tier: string | null;
+  summary: string | null;
+  timestamp: string;
+  expires_at: string | null;
+  signature: {
+    algorithm: string | null;
+    key_id: string | null;
+    value: string | null;
+    verified: boolean;
+  };
+  issuer: string;
+  receipt_version: number;
+  url: string;
+}
+
+function extractActionFields(requestJson: string | null): {
+  action: string | null;
+  resource: string | null;
+} {
+  if (!requestJson) return { action: null, resource: null };
+
+  try {
+    const parsed = JSON.parse(requestJson);
+    return {
+      action: parsed.action?.tool || parsed.action?.operation || parsed.intent?.name || null,
+      resource: parsed.action?.resource || parsed.context?.environment || null,
+    };
+  } catch {
+    return { action: null, resource: null };
+  }
+}
+
+function extractDeployRequestId(requestJson: string | null): string | null {
+  if (!requestJson) return null;
+
+  try {
+    const parsed = JSON.parse(requestJson);
+    const requestId = parsed?.metadata?.deployGateRequestId;
+    return typeof requestId === "string" ? requestId : null;
+  } catch {
+    return null;
+  }
+}
+
+export function buildDemoPublicReceipt(now: Date = new Date()): PublicReceiptView {
+  const timestamp = new Date(now.getTime() - 2 * 60 * 60 * 1000).toISOString();
+
+  return {
+    receipt_id: "demo",
+    status: "AUTHORIZED",
+    action: "deploy",
+    resource: "billing-service",
+    actor: "deploy-bot",
+    approved_by: "Sarah Kim",
