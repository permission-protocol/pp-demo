export default function DeployGateRequestPage() {
  const params = useParams<{ requestId: string; companySlug?: string }>();
  const router = useRouter();
  const searchParams = useSearchParams();
  const requestId = params?.requestId;
  const routeCompanySlug = params?.companySlug;

  const [request, setRequest] = useState<DeployGateRequest | null>(null);
  const [loading, setLoading] = useState(true);
  const [error, setError] = useState<string | null>(null);
