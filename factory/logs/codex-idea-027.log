import { describe, expect, it } from 'vitest';
import { getBranchStatus } from '@/app/pp/deploy-requests/[requestId]/review-page-helpers';

describe('getBranchStatus', () => {
  it('shows approval-specific pending copy while GitHub recomputes mergeability', () => {
    expect(
      getBranchStatus(
        {
          mergeable: null,
          mergeable_state: 'unknown',
          checks: [],
          checks_passing: 0,
          checks_total: 0,
          behind_by: 0,
        },
        'approved'
      )
    ).toEqual({
      tone: 'pending',
      label: 'Checks re-running after approval...',
    });
  });
});
