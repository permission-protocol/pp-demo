+function getCompanyRequestPath(companySlug: string, requestId: string): string {
+  return `/pp/c/${encodeURIComponent(companySlug)}/deploy-requests/${requestId}`;
+}
+
+function getCompanyDeployRequestsPath(companySlug: string | null): string {
+  return companySlug ? `/pp/c/${encodeURIComponent(companySlug)}/deploy-requests` : '/c/deploy-requests';
+}
+
+function getEnvironmentBadgeClasses(environment: string): string {
+  return environment.toLowerCase() === 'production'
+    ? 'border-amber-400/30 bg-amber-400/12 text-amber-100'
+    : 'border-sky-400/30 bg-sky-400/12 text-sky-100';
+}
+
+function getVerdictPresentation(summary: string | null): {
+  icon: string;
+  label: string;
+  accentClassName: string;
+  accentColor: string;
+  what: string;
+} | null {
+  if (!summary) {
+    return null;
+  }
+  const parsed = parseAiSummary(summary);
+  if (parsed.riskLevel === 'high') {
+    return {
+      icon: '🔴',
+      label: 'Block recommended',
+      accentClassName: 'border-red-500/30 bg-red-500/12 text-red-200',
+      accentColor: '#ef4444',
+      what: parsed.what,
+    };
+  }
+  if (parsed.riskLevel === 'medium') {
+    return {
+      icon: '🟡',
+      label: 'Review carefully',
+      accentClassName: 'border-yellow-500/30 bg-yellow-500/12 text-yellow-100',
+      accentColor: '#eab308',
+      what: parsed.what,
+    };
+  }
+  return {
+    icon: '🟢',
+    label: 'Routine',
+    accentClassName: 'border-emerald-500/25 bg-emerald-500/10 text-emerald-100',
+    accentColor: '#10b981',
+    what: parsed.what,
+  };
+}
+
+function DeployQueueCard({
+  request,
+  companySlug,
+  onApproved,
+}: {
+  request: DeployRequestListItem;
+  companySlug: string;
+  onApproved: (requestId: string) => void;
+}) {
+  const router = useRouter();
+  const { addToast } = useToast();
+  const [enrichment, setEnrichment] = useState<ReviewEnrichment | null>(null);
+  const [enrichmentLoading, setEnrichmentLoading] = useState(false);
+  const [approvalLoading, setApprovalLoading] = useState(false);
+
+  useEffect(() => {
+    let active = true;
+
+    const fetchEnrichment = async () => {
+      if (!request.id || !request.prNumber) {
+        setEnrichment(null);
+        return;
+      }
+      setEnrichmentLoading(true);
+      try {
+        const response = await fetch(`/api/v1/deploy-requests/${request.id}/enrichment`);
+        const data = await response.json();
+        if (!response.ok || !data?.enrichment) {
+          throw new Error(data?.error?.message || 'Failed to load AI assessment');
+        }
+        if (active) {
+          setEnrichment(data.enrichment as ReviewEnrichment);
+        }
+      } catch {
+        if (active) {
+          setEnrichment(null);
+        }
+      } finally {
+        if (active) {
+          setEnrichmentLoading(false);
+        }
+      }
+    };
+
+    void fetchEnrichment();
+
+    return () => {
+      active = false;
+    };
+  }, [request.id, request.prNumber]);
+
+  const verdict = useMemo(() => getVerdictPresentation(enrichment?.summary ?? null), [enrichment?.summary]);
+  const reviewHref = getCompanyRequestPath(companySlug, request.id);
+
+  const handleApprove = useCallback(async () => {
+    if (!verdict) {
+      return;
+    }
+    setApprovalLoading(true);
+    try {
+      const response = await fetch(`/api/v1/deploy-requests/${request.id}/approve`, {
+        method: 'POST',
+        headers: { 'Content-Type': 'application/json' },
+        body: JSON.stringify({ productionConfirmed: true }),
+      });
+      const data = await response.json();
+      if (data?.error?.code === 'UNAUTHENTICATED') {
+        const callbackUrl = `${window.location.pathname}${window.location.search}`;
+        router.push(`/auth/signin?callbackUrl=${encodeURIComponent(callbackUrl)}`);
+        return;
+      }
+      if (!response.ok || !data?.success) {
+        throw new Error(data?.error?.message || 'Approval failed');
+      }
+      onApproved(request.id);
+    } catch (error) {
+      addToast({
+        type: 'error',
+        title: 'Approval failed',
+        message: error instanceof Error ? error.message : 'Could not approve deploy request.',
+      });
+    } finally {
+      setApprovalLoading(false);
+    }
+  }, [addToast, onApproved, request.id, router, verdict]);
+
+  return (
+    <div
+      className="rounded-2xl border border-[var(--border)] bg-[var(--card)] p-4"
+      style={{ borderLeftWidth: 4, borderLeftColor: verdict?.accentColor ?? 'var(--border)' }}
+    >
+      <div className="flex items-start justify-between gap-3">
+        <div className="min-w-0 space-y-2">
+          <div className="flex flex-wrap items-center gap-2">
+            <span className={`inline-flex items-center rounded-full border px-2.5 py-1 text-xs font-medium ${verdict?.accentClassName ?? 'border-[var(--border)] text-[var(--muted)]'}`}>
+              {verdict ? `${verdict.icon} ${verdict.label}` : enrichmentLoading ? 'Assessing…' : 'No verdict'}
+            </span>
+          </div>
+          <p className="line-clamp-1 text-sm font-medium text-[var(--foreground)]">
+            {verdict?.what ?? (enrichmentLoading ? 'Loading AI summary…' : request.prTitle || `Deploy request for ${shortenRepo(request.repo)}`)}
+          </p>
+        </div>
+        <span className="shrink-0 text-xs text-[var(--muted)]">{formatRelativeTime(request.createdAt)}</span>
+      </div>
+
+      <div className="mt-3 flex flex-wrap items-center gap-2 text-xs text-[var(--muted)]">
+        <span className="inline-flex items-center gap-1.5">
+          <FolderGit2 className="h-3.5 w-3.5" />
+          {shortenRepo(request.repo)}
+        </span>
+        <span className={`inline-flex items-center rounded-full border px-2 py-0.5 font-medium ${getEnvironmentBadgeClasses(request.env)}`}>
+          {request.env}
+        </span>
+        {request.prNumber != null ? (
+          <span className="inline-flex items-center gap-1.5">
+            <GitPullRequest className="h-3.5 w-3.5" />
+            PR #{request.prNumber}
+          </span>
+        ) : null}
+      </div>
+
+      <div className="mt-4 flex items-center gap-2">
+        <Button
+          size="sm"
+          className="bg-[#10B981] text-[#0a0a0a] hover:opacity-90"
+          disabled={enrichmentLoading || approvalLoading || !verdict}
+          loading={approvalLoading}
+          onClick={() => void handleApprove()}
+        >
+          <Check className="h-4 w-4" />
+          Approve
+        </Button>
+        <Link href={reviewHref}>
+          <Button variant="ghost" size="sm" className="px-0 text-[var(--foreground)] hover:bg-transparent hover:text-white">
+            Review →
