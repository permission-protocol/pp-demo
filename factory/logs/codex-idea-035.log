export function parseAiSummary(summary: string): ParsedAiSummary {
  const normalized = normalizeAiSummaryText(summary);
  const firstSentence = firstNonEmptySentence(normalized);
  const details = normalized.startsWith(firstSentence)
    ? normalized.slice(firstSentence.length).trim()
    : normalized;
  const lower = normalized.toLowerCase();

  const riskLevel: ParsedAiRiskLevel = /high risk|risky|dangerous|block(?:ed|ing)? recommended|do not merge|unsafe/.test(lower)
    ? 'high'
    : /medium risk|review carefully|review needed|needs review|caution|mixed risk/.test(lower)
      ? 'medium'
      : 'low';

  const action = /block(?:ed|ing)? recommended|do not merge|should not go live|unsafe to merge/.test(lower)
    ? 'Block recommended'
    : /review carefully|review needed|needs review|double-check|caution/.test(lower)
      ? 'Review carefully'
      : 'Safe to merge';

