+function DeployQueueCards({
+  requests,
+  companySlug,
+  onApproved,
+}: {
+  requests: DeployRequestListItem[];
+  companySlug: string;
+  onApproved: (requestId: string) => void;
+}) {
+  const sortedRequests = useMemo(
+    () =>
+      [...requests].sort((a, b) => {
+        const aProduction = a.env.toLowerCase() === 'production' ? 0 : 1;
+        const bProduction = b.env.toLowerCase() === 'production' ? 0 : 1;
+        if (aProduction !== bProduction) {
+          return aProduction - bProduction;
+        }
+        return new Date(a.createdAt).getTime() - new Date(b.createdAt).getTime();
+      }),
+    [requests]
+  );
+
+  if (sortedRequests.length === 0) {
+    return (
+      <div className="rounded-lg border border-dashed border-[var(--border)] bg-[var(--background)] px-4 py-10 text-center text-sm text-[var(--muted)]">
+        No pending approvals 🎉
+      </div>
+    );
+  }
+
+  const visibleRequests = sortedRequests.slice(0, 5);
+  const viewAllHref = getCompanyDeployRequestsPath(companySlug);
+
+  return (
+    <div className="space-y-4">
+      <div className="grid gap-3 md:grid-cols-2 md:gap-4">
+        {visibleRequests.map((request) => (
+          <DeployQueueCard key={request.id} request={request} companySlug={companySlug} onApproved={onApproved} />
+        ))}
+      </div>
+      {sortedRequests.length > 5 ? (
+        <div className="text-right">
+          <Link href={viewAllHref} className="text-sm text-[var(--muted)] hover:text-[var(--foreground)]">
+            View all pending →
+          </Link>
+        </div>
+      ) : null}
+    </div>
+  );
+}
