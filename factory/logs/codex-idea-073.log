+function buildLocalReceiptViewData(receiptId: string): ReceiptViewData | null {
+  const request = getReviewRequests().find((item) => item.id === receiptId);
+  if (!request || request.status === "pending") return null;
+
+  const approvalStatus =
+    request.status === "denied" ? "DENIED" : request.status === "expired" ? "EXPIRED" : "APPROVED";
+  const normalizedStatus = request.status === "merged" ? "approved" : request.status;
+
+  return {
+    id: request.id,
+    action: "deploy",
+    action_label: `deploy -> ${request.environment}`,
+    repo: request.repo,
+    pr_number: request.prNumber,
+    pr_url: `https://github.com/${request.repo}/pull/${request.prNumber}`,
+    commit_sha: null,
+    commit_url: null,
+    approved_by: request.approver,
+    approved_by_url: request.approver ? `https://github.com/${request.approver.replace(/\s+/g, "")}` : null,
+    actor: request.author,
+    actor_type: "system",
+    policy: "deploy-approval",
+    timestamp: request.decidedAt ?? request.requestedAt,
+    created_at: request.requestedAt,
+    approved_at: request.status === "approved" || request.status === "merged" ? request.decidedAt : null,
+    merge_unblocked_at: request.status === "merged" ? request.decidedAt : null,
+    signature: null,
+    signature_verified: null,
+    signature_status: "unknown",
+    status: normalizedStatus,
+    approval_status: approvalStatus,
+    verification_status: null,
+    verification_failure_code: null,
+    has_receipt: false,
+    request_id: request.id,
+    technical_json: {
+      request_id: request.id,
+      action: "deploy",
+      repo: request.repo,
+      pr_number: request.prNumber,
+      approved_by: request.approver,
+      actor: request.author,
+      policy: "deploy-approval",
+      created_at: request.requestedAt,
+      approved_at: request.decidedAt,
+      merge_unblocked_at: request.status === "merged" ? request.decidedAt : null,
+      status: normalizedStatus,
+      approval_status: approvalStatus,
+      has_receipt: false
