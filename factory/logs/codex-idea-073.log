                  <Link href={`/review?request=${request.id}`} className="text-sm font-semibold text-permit">
                    Open review
                  </Link>
                </div>
              </article>
            ))}
          </section>
        ) : null}

        {activeTab === "history" ? <DeployHistory requests={requests} /> : null}
      </div>
    </div>
  );
}
