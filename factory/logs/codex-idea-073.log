+              {filteredRequests.filter((request) => request.status === "approved" || request.status === "merged").length}
+            </p>
+          </div>
+          <div className="rounded-2xl border border-border bg-ash/50 p-4">
+            <p className="text-xs uppercase tracking-[0.14em] text-secondary">Average decision time</p>
+            <p className="mt-2 text-3xl font-semibold text-signal">
