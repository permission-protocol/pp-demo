diff --git a/src/components/DeployHistory.tsx b/src/components/DeployHistory.tsx
new file mode 100644
index 0000000000000000000000000000000000000000..08af767a536a9e49f3a52bb7713d7b1ff997606e
--- /dev/null
+++ b/src/components/DeployHistory.tsx
@@ -0,0 +1,395 @@
+"use client";
+
+import { useMemo, useState } from "react";
+import Link from "next/link";
+import type { ReviewRequest, ReviewRiskTier } from "@/src/lib/reviewData";
+
+type DateRangePreset = "today" | "7d" | "30d" | "custom";
+type StatusFilter = "all" | "approved" | "denied" | "expired";
+
+type DeployHistoryProps = {
+  requests: ReviewRequest[];
+};
+
+function riskClasses(riskTier: ReviewRiskTier) {
+  if (riskTier === "critical") {
+    return "border-fuchsia-500/35 bg-fuchsia-500/10 text-fuchsia-200";
+  }
+
+  if (riskTier === "high") {
+    return "border-red-500/35 bg-red-500/10 text-red-200";
+  }
+
+  if (riskTier === "medium") {
+    return "border-amber-500/35 bg-amber-500/10 text-amber-200";
+  }
+
+  return "border-emerald-500/35 bg-emerald-500/10 text-emerald-200";
+}
+
+function statusClasses(status: ReviewRequest["status"]) {
+  if (status === "approved" || status === "merged") {
+    return "border-emerald-500/35 bg-emerald-500/10 text-emerald-200";
+  }
+
+  if (status === "denied") {
+    return "border-red-500/35 bg-red-500/10 text-red-200";
+  }
+
+  return "border-zinc-500/35 bg-zinc-500/10 text-zinc-200";
+}
+
+function formatDateTime(value: string | null) {
+  if (!value) return "Unknown";
+
+  const date = new Date(value);
+  if (Number.isNaN(date.getTime())) return value;
+
+  return new Intl.DateTimeFormat("en-US", {
+    month: "short",
+    day: "numeric",
+    year: "numeric",
+    hour: "numeric",
+    minute: "2-digit",
+    timeZone: "UTC",
+    timeZoneName: "short"
+  }).format(date);
+}
+
+function formatDateInputValue(value: Date) {
+  return value.toISOString().slice(0, 10);
+}
+
+function formatDurationMinutes(start: string, end: string | null) {
+  if (!end) return "Pending";
+
+  const requested = new Date(start).getTime();
+  const decided = new Date(end).getTime();
+
+  if (Number.isNaN(requested) || Number.isNaN(decided) || decided < requested) {
+    return "Unknown";
+  }
+
+  const minutes = Math.round((decided - requested) / 60000);
+  if (minutes < 60) return `${minutes} min`;
+
+  const hours = Math.floor(minutes / 60);
+  const remainder = minutes % 60;
+  return remainder === 0 ? `${hours} hr` : `${hours} hr ${remainder} min`;
+}
+
+function downloadCsv(rows: ReviewRequest[]) {
+  const header = ["date", "repo", "pr", "risk tier", "actor", "approver", "decision", "time-to-decision"];
+  const lines = rows.map((request) => [
+    request.decidedAt ?? request.requestedAt,
+    request.repo,
+    `#${request.prNumber} ${request.prTitle}`,
+    request.riskTier,
+    request.author,
+    request.approver ?? "",
+    request.status,
+    formatDurationMinutes(request.requestedAt, request.decidedAt)
+  ]);
+
+  const csv = [header, ...lines]
+    .map((line) => line.map((value) => `"${String(value).replace(/"/g, "\"\"")}"`).join(","))
+    .join("\n");
+
+  const blob = new Blob([csv], { type: "text/csv;charset=utf-8" });
+  const url = window.URL.createObjectURL(blob);
+  const anchor = document.createElement("a");
+  anchor.href = url;
+  anchor.download = "deploy-history.csv";
+  anchor.click();
+  window.URL.revokeObjectURL(url);
+}
+
+export function DeployHistory({ requests }: DeployHistoryProps) {
+  const historyRequests = useMemo(
+    () =>
+      requests
+        .filter((request) => request.status !== "pending")
+        .sort((a, b) => new Date(b.decidedAt ?? b.requestedAt).getTime() - new Date(a.decidedAt ?? a.requestedAt).getTime()),
+    [requests]
+  );
+
+  const repoOptions = useMemo(() => [...new Set(historyRequests.map((request) => request.repo))].sort(), [historyRequests]);
+  const approverOptions = useMemo(
+    () =>
+      [...new Set(historyRequests.map((request) => request.approver).filter((value): value is string => Boolean(value)))].sort(),
+    [historyRequests]
+  );
+
+  const today = useMemo(() => new Date(), []);
+  const [dateRange, setDateRange] = useState<DateRangePreset>("30d");
+  const [status, setStatus] = useState<StatusFilter>("all");
+  const [repo, setRepo] = useState("all");
+  const [environment, setEnvironment] = useState("all");
+  const [approver, setApprover] = useState("");
+  const [riskTier, setRiskTier] = useState<"all" | ReviewRiskTier>("all");
+  const [customStart, setCustomStart] = useState(formatDateInputValue(new Date(today.getTime() - 29 * 24 * 60 * 60 * 1000)));
+  const [customEnd, setCustomEnd] = useState(formatDateInputValue(today));
+
+  const filteredRequests = useMemo(() => {
+    const rangeStart = (() => {
+      if (dateRange === "today") {
+        const start = new Date(today);
+        start.setHours(0, 0, 0, 0);
+        return start.getTime();
+      }
+
+      if (dateRange === "7d") {
+        return today.getTime() - 7 * 24 * 60 * 60 * 1000;
+      }
+
+      if (dateRange === "30d") {
+        return today.getTime() - 30 * 24 * 60 * 60 * 1000;
+      }
+
+      const parsed = new Date(`${customStart}T00:00:00Z`).getTime();
+      return Number.isNaN(parsed) ? Number.NEGATIVE_INFINITY : parsed;
+    })();
+
+    const rangeEnd = (() => {
+      if (dateRange !== "custom") return Number.POSITIVE_INFINITY;
+      const parsed = new Date(`${customEnd}T23:59:59Z`).getTime();
+      return Number.isNaN(parsed) ? Number.POSITIVE_INFINITY : parsed;
+    })();
+
+    const approverQuery = approver.trim().toLowerCase();
+
+    return historyRequests.filter((request) => {
+      const eventTime = new Date(request.decidedAt ?? request.requestedAt).getTime();
+      const matchesDate = eventTime >= rangeStart && eventTime <= rangeEnd;
+      const matchesStatus =
+        status === "all" ? true : status === "approved" ? request.status === "approved" || request.status === "merged" : request.status === status;
+      const matchesRepo = repo === "all" || request.repo === repo;
+      const matchesEnvironment = environment === "all" || request.environment === environment;
+      const matchesApprover =
+        approverQuery.length === 0 || (request.approver ?? "").toLowerCase().includes(approverQuery);
+      const matchesRisk = riskTier === "all" || request.riskTier === riskTier;
+
+      return matchesDate && matchesStatus && matchesRepo && matchesEnvironment && matchesApprover && matchesRisk;
+    });
+  }, [approver, customEnd, customStart, dateRange, environment, historyRequests, repo, riskTier, status, today]);
+
+  const averageDecisionMinutes = useMemo(() => {
+    const durations = filteredRequests
+      .filter((request) => request.decidedAt)
+      .map((request) => (new Date(request.decidedAt!).getTime() - new Date(request.requestedAt).getTime()) / 60000)
+      .filter((value) => Number.isFinite(value) && value >= 0);
+
+    if (durations.length === 0) return null;
+    return Math.round(durations.reduce((total, value) => total + value, 0) / durations.length);
+  }, [filteredRequests]);
+
+  return (
+    <section className="mt-6 rounded-[1.75rem] border border-border bg-card/80 p-5 md:p-6">
+      <div className="flex flex-col gap-4 border-b border-border pb-5">
+        <div className="flex flex-col gap-4 md:flex-row md:items-start md:justify-between">
+          <div>
+            <p className="text-xs uppercase tracking-[0.18em] text-permit">History</p>
+            <h2 className="mt-2 text-2xl font-semibold text-signal">Completed deploy decisions</h2>
+            <p className="mt-2 max-w-2xl text-sm text-secondary">
+              Search approvals, denials, merges, and expirations for compliance reviews and release audits.
+            </p>
+          </div>
+          <button type="button" onClick={() => downloadCsv(filteredRequests)} className="btn-secondary px-4 py-2 text-sm">
+            Export CSV
+          </button>
+        </div>
+
+        <div className="grid gap-3 md:grid-cols-2 xl:grid-cols-6">
+          <label className="rounded-2xl border border-border bg-ash/50 p-3 text-sm text-secondary">
+            Date range
+            <select
+              value={dateRange}
+              onChange={(event) => setDateRange(event.target.value as DateRangePreset)}
+              className="mt-2 w-full rounded-xl border border-border bg-card px-3 py-2 text-signal"
+            >
+              <option value="today">Today</option>
+              <option value="7d">Last 7 days</option>
+              <option value="30d">Last 30 days</option>
+              <option value="custom">Custom</option>
+            </select>
+          </label>
+
+          <label className="rounded-2xl border border-border bg-ash/50 p-3 text-sm text-secondary">
+            Status
+            <select
+              value={status}
+              onChange={(event) => setStatus(event.target.value as StatusFilter)}
+              className="mt-2 w-full rounded-xl border border-border bg-card px-3 py-2 text-signal"
+            >
+              <option value="all">All</option>
+              <option value="approved">Approved</option>
+              <option value="denied">Denied</option>
+              <option value="expired">Expired</option>
+            </select>
+          </label>
+
+          <label className="rounded-2xl border border-border bg-ash/50 p-3 text-sm text-secondary">
+            Repository
+            <select value={repo} onChange={(event) => setRepo(event.target.value)} className="mt-2 w-full rounded-xl border border-border bg-card px-3 py-2 text-signal">
+              <option value="all">All repos</option>
+              {repoOptions.map((option) => (
+                <option key={option} value={option}>
+                  {option}
+                </option>
+              ))}
+            </select>
+          </label>
+
+          <label className="rounded-2xl border border-border bg-ash/50 p-3 text-sm text-secondary">
+            Environment
+            <select
+              value={environment}
+              onChange={(event) => setEnvironment(event.target.value)}
+              className="mt-2 w-full rounded-xl border border-border bg-card px-3 py-2 text-signal"
+            >
+              <option value="all">All envs</option>
+              <option value="production">Production</option>
+              <option value="staging">Staging</option>
+            </select>
+          </label>
+
+          <label className="rounded-2xl border border-border bg-ash/50 p-3 text-sm text-secondary">
+            Approver
+            <input
+              type="search"
+              list="history-approvers"
+              value={approver}
+              onChange={(event) => setApprover(event.target.value)}
