+                </div>
+                <h3 className="mt-3 text-2xl font-semibold text-signal">{request.prTitle}</h3>
+                <p className="mt-2 max-w-3xl text-sm text-secondary">{request.summary}</p>
+              </div>
+
+              <div className="rounded-2xl border border-border bg-ash/60 px-4 py-3 text-sm text-secondary lg:min-w-[260px]">
