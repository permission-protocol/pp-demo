+export function routeOutcome(policyOutcome: PolicyOutcome, receiptId: string): RoutedOutcome {
+  switch (policyOutcome) {
+    case 'approval_required':
+      return { status: 'held', receipt_id: receiptId };
+    case 'denied':
+      return { status: 'denied', receipt_id: receiptId };
+    case 'cleared':
+    default:
+      return { status: 'cleared', receipt_id: receiptId };
+  }
