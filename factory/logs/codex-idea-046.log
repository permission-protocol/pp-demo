export function getCheckSummary(readiness: MergeReadiness | null, requestStatus?: string): string {
  if (!readiness) return 'Checking GitHub status...';
  if (readiness.checks_total === 0) {
    return requestStatus === 'approved' ? 'Waiting for checks to re-run...' : 'No check runs reported (0/0)';
  }
  if (readiness.checks_passing === readiness.checks_total && readiness.checks.every((check) => !isFailingCheck(check))) {
    return `All checks passing (${readiness.checks_passing}/${readiness.checks_total})`;
  }
  return `${readiness.checks_total - readiness.checks_passing} check${readiness.checks_total - readiness.checks_passing === 1 ? '' : 's'} not passing`;
}

