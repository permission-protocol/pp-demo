new file mode 100644
index 0000000000000000000000000000000000000000..e2af0f152737fc39697c487636b29abbe9b4d6b9
--- /dev/null
+++ b/src/lib/audit/presentation.ts
@@ -0,0 +1,80 @@
+export interface AuditActorLookup {
+  id: string;
+  handle: string | null;
+  name: string | null;
+}
+
+const ACTOR_ID_PREFIXES = ['user:', 'cli:'] as const;
+
+export function isRawActorId(value: string | null | undefined): boolean {
+  if (!value) {
+    return false;
+  }
+  return value.startsWith('cm') && value.length > 20 && !/\s/.test(value);
+}
+
+export function extractActorUserId(actor: string | null | undefined): string | null {
+  if (!actor) {
+    return null;
+  }
+  if (isRawActorId(actor)) {
+    return actor;
+  }
+  for (const prefix of ACTOR_ID_PREFIXES) {
+    if (actor.startsWith(prefix)) {
+      const candidate = actor.slice(prefix.length);
+      return isRawActorId(candidate) ? candidate : null;
+    }
+  }
+  return null;
+}
+
+export function truncateActorId(actor: string): string {
+  if (actor.length <= 12) {
+    return actor;
+  }
+  return `${actor.slice(0, 6)}...${actor.slice(-5)}`;
+}
+
+export function resolveAuditRequestedBy(
+  requestedBy: string,
+  lookups: Map<string, AuditActorLookup>
+): string {
+  const actorUserId = extractActorUserId(requestedBy);
+  if (!actorUserId) {
+    return requestedBy;
+  }
+
+  const lookup = lookups.get(actorUserId);
+  if (!lookup) {
+    return requestedBy;
+  }
+
+  return lookup.handle || lookup.name || requestedBy;
+}
+
+export function getAuditDecisionLabel(decision: string): string {
+  switch (decision.toLowerCase()) {
+    case 'allow':
+      return 'Approved';
+    case 'deny':
+      return 'Denied';
+    case 'expired':
+      return 'Expired';
+    default:
+      return decision.replace(/_/g, ' ');
+  }
+}
+
+export function getAuditDecisionIcon(decision: string): string {
+  switch (decision.toLowerCase()) {
+    case 'allow':
+      return '✅';
+    case 'deny':
+      return '❌';
+    case 'expired':
+      return '⏰';
+    default:
+      return '•';
+  }
+}
