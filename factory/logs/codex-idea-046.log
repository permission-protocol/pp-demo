+import { describe, expect, it } from 'vitest';
+import {
+  extractActorUserId,
+  getAuditDecisionIcon,
+  getAuditDecisionLabel,
+  isRawActorId,
+  resolveAuditRequestedBy,
+  truncateActorId,
+} from '@/lib/audit/presentation';
+
+describe('audit presentation helpers', () => {
+  it('detects raw internal actor IDs', () => {
+    expect(isRawActorId('cmkrc6fib000090cjwvvrstlq')).toBe(true);
+    expect(isRawActorId('user:cmkrc6fib000090cjwvvrstlq')).toBe(false);
+    expect(isRawActorId('system')).toBe(false);
+  });
+
+  it('extracts user IDs from raw and prefixed actor keys', () => {
+    expect(extractActorUserId('cmkrc6fib000090cjwvvrstlq')).toBe('cmkrc6fib000090cjwvvrstlq');
+    expect(extractActorUserId('user:cmkrc6fib000090cjwvvrstlq')).toBe('cmkrc6fib000090cjwvvrstlq');
+    expect(extractActorUserId('cli:cmkrc6fib000090cjwvvrstlq')).toBe('cmkrc6fib000090cjwvvrstlq');
+    expect(extractActorUserId('api_key:key_123')).toBeNull();
+  });
+
+  it('resolves requestedBy to a user handle when available', () => {
+    const lookups = new Map([
+      ['cmkrc6fib000090cjwvvrstlq', { id: 'cmkrc6fib000090cjwvvrstlq', handle: 'octocat', name: 'The Octocat' }],
+    ]);
+
+    expect(resolveAuditRequestedBy('cmkrc6fib000090cjwvvrstlq', lookups)).toBe('octocat');
+    expect(resolveAuditRequestedBy('user:cmkrc6fib000090cjwvvrstlq', lookups)).toBe('octocat');
+  });
+
+  it('preserves the original actor when no lookup exists', () => {
+    expect(resolveAuditRequestedBy('cmkrc6fib000090cjwvvrstlq', new Map())).toBe('cmkrc6fib000090cjwvvrstlq');
+  });
+
+  it('truncates raw IDs for compact display', () => {
+    expect(truncateActorId('cmkrc6fib000090cjwvvrstlq')).toBe('cmkrc6...rstlq');
+  });
+
+  it('formats decision labels and icons for the audit table', () => {
+    expect(getAuditDecisionLabel('allow')).toBe('Approved');
+    expect(getAuditDecisionLabel('deny')).toBe('Denied');
+    expect(getAuditDecisionLabel('expired')).toBe('Expired');
+    expect(getAuditDecisionIcon('allow')).toBe('✅');
+    expect(getAuditDecisionIcon('deny')).toBe('❌');
+    expect(getAuditDecisionIcon('expired')).toBe('⏰');
+  });
+});


