diff --git a/src/lib/audit/presentation.ts b/src/lib/audit/presentation.ts
new file mode 100644
index 0000000000000000000000000000000000000000..e2af0f152737fc39697c487636b29abbe9b4d6b9
--- /dev/null
+++ b/src/lib/audit/presentation.ts
@@ -0,0 +1,80 @@
+export interface AuditActorLookup {
+  id: string;
+  handle: string | null;
+  name: string | null;
+}
+
+const ACTOR_ID_PREFIXES = ['user:', 'cli:'] as const;
+
+export function isRawActorId(value: string | null | undefined): boolean {
+  if (!value) {
+    return false;
+  }
+  return value.startsWith('cm') && value.length > 20 && !/\s/.test(value);
+}
+
+export function extractActorUserId(actor: string | null | undefined): string | null {
+  if (!actor) {
+    return null;
+  }
+  if (isRawActorId(actor)) {
+    return actor;
+  }
+  for (const prefix of ACTOR_ID_PREFIXES) {
+    if (actor.startsWith(prefix)) {
+      const candidate = actor.slice(prefix.length);
+      return isRawActorId(candidate) ? candidate : null;
+    }
+  }
+  return null;
+}
+
+export function truncateActorId(actor: string): string {
+  if (actor.length <= 12) {
+    return actor;
+  }
+  return `${actor.slice(0, 6)}...${actor.slice(-5)}`;
+}
+
+export function resolveAuditRequestedBy(
+  requestedBy: string,
+  lookups: Map<string, AuditActorLookup>
+): string {
+  const actorUserId = extractActorUserId(requestedBy);
+  if (!actorUserId) {
+    return requestedBy;
+  }
+
+  const lookup = lookups.get(actorUserId);
+  if (!lookup) {
+    return requestedBy;
+  }
+
+  return lookup.handle || lookup.name || requestedBy;
+}
+
+export function getAuditDecisionLabel(decision: string): string {
+  switch (decision.toLowerCase()) {
+    case 'allow':
+      return 'Approved';
+    case 'deny':
+      return 'Denied';
+    case 'expired':
+      return 'Expired';
+    default:
+      return decision.replace(/_/g, ' ');
+  }
+}
+
+export function getAuditDecisionIcon(decision: string): string {
+  switch (decision.toLowerCase()) {
+    case 'allow':
+      return '✅';
+    case 'deny':
+      return '❌';
+    case 'expired':
+      return '⏰';
+    default:
+      return '•';
+  }
+}
diff --git a/tests/audit-presentation.test.ts b/tests/audit-presentation.test.ts
new file mode 100644
index 0000000000000000000000000000000000000000..b32ac97a0c53433bc63fec7fdaff09c724124563
--- /dev/null
+++ b/tests/audit-presentation.test.ts
@@ -0,0 +1,50 @@
+import { describe, expect, it } from 'vitest';
+import {
+  extractActorUserId,
+  getAuditDecisionIcon,
+  getAuditDecisionLabel,
+  isRawActorId,
+  resolveAuditRequestedBy,
+  truncateActorId,
+} from '@/lib/audit/presentation';
+
+describe('audit presentation helpers', () => {
+  it('detects raw internal actor IDs', () => {
+    expect(isRawActorId('cmkrc6fib000090cjwvvrstlq')).toBe(true);
+    expect(isRawActorId('user:cmkrc6fib000090cjwvvrstlq')).toBe(false);
+    expect(isRawActorId('system')).toBe(false);
+  });
+
+  it('extracts user IDs from raw and prefixed actor keys', () => {
+    expect(extractActorUserId('cmkrc6fib000090cjwvvrstlq')).toBe('cmkrc6fib000090cjwvvrstlq');
+    expect(extractActorUserId('user:cmkrc6fib000090cjwvvrstlq')).toBe('cmkrc6fib000090cjwvvrstlq');
+    expect(extractActorUserId('cli:cmkrc6fib000090cjwvvrstlq')).toBe('cmkrc6fib000090cjwvvrstlq');
+    expect(extractActorUserId('api_key:key_123')).toBeNull();
+  });
+
+  it('resolves requestedBy to a user handle when available', () => {
+    const lookups = new Map([
+      ['cmkrc6fib000090cjwvvrstlq', { id: 'cmkrc6fib000090cjwvvrstlq', handle: 'octocat', name: 'The Octocat' }],
+    ]);
+
+    expect(resolveAuditRequestedBy('cmkrc6fib000090cjwvvrstlq', lookups)).toBe('octocat');
+    expect(resolveAuditRequestedBy('user:cmkrc6fib000090cjwvvrstlq', lookups)).toBe('octocat');
+  });
+
+  it('preserves the original actor when no lookup exists', () => {
+    expect(resolveAuditRequestedBy('cmkrc6fib000090cjwvvrstlq', new Map())).toBe('cmkrc6fib000090cjwvvrstlq');
+  });
+
+  it('truncates raw IDs for compact display', () => {
+    expect(truncateActorId('cmkrc6fib000090cjwvvrstlq')).toBe('cmkrc6...rstlq');
+  });
+
+  it('formats decision labels and icons for the audit table', () => {
+    expect(getAuditDecisionLabel('allow')).toBe('Approved');
+    expect(getAuditDecisionLabel('deny')).toBe('Denied');
+    expect(getAuditDecisionLabel('expired')).toBe('Expired');
+    expect(getAuditDecisionIcon('allow')).toBe('✅');
+    expect(getAuditDecisionIcon('deny')).toBe('❌');
+    expect(getAuditDecisionIcon('expired')).toBe('⏰');
+  });
+});

