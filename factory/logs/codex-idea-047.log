@@ -0,0 +1,23 @@
+import { NextRequest, NextResponse } from 'next/server';
+import { requireTenant } from '@/lib/auth/require-tenant';
+import { httpError, ErrorCodes } from '@/lib/http/errors';
+import { getGitHubAppRepoStatus } from '@/lib/github-app/repo-status';
+
+export const runtime = 'nodejs';
+export const dynamic = 'force-dynamic';
+
+export async function GET(request: NextRequest): Promise<NextResponse> {
+  const repo = request.nextUrl.searchParams.get('repo')?.trim();
+  if (!repo) {
+    return httpError(ErrorCodes.VALIDATION_ERROR, 'repo is required');
+  }
+
+  try {
+    const tenant = await requireTenant();
+    const status = await getGitHubAppRepoStatus(tenant.companyId, repo);
+    return NextResponse.json(status);
+  } catch (error) {
+    console.error('[github-app/repos/status] GET error:', error);
+    return httpError(ErrorCodes.INTERNAL_ERROR);
+  }
+}
