import { beforeEach, describe, expect, it, vi } from 'vitest';

const mockGitHubAppRepoFindFirst = vi.fn();
const mockGitHubAppInstallationFindFirst = vi.fn();

vi.mock('@/lib/company/raw-prisma', () => ({
  rawPrisma: {
    gitHubAppRepo: {
      findFirst: (...args: unknown[]) => mockGitHubAppRepoFindFirst(...args),
    },
    gitHubAppInstallation: {
      findFirst: (...args: unknown[]) => mockGitHubAppInstallationFindFirst(...args),
    },
  },
}));

describe('getGitHubAppRepoStatus', () => {
  beforeEach(() => {
    vi.resetModules();
    vi.clearAllMocks();
    mockGitHubAppRepoFindFirst.mockResolvedValue(null);
    mockGitHubAppInstallationFindFirst.mockResolvedValue(null);
  });

  it('returns ready when the repo is connected and fully configured', async () => {
    mockGitHubAppRepoFindFirst.mockResolvedValue({
      workflowInstalled: true,
      secretInjected: true,
      rulesetCreated: true,
      installation: { installationId: 115918626 },
    });

    const { getGitHubAppRepoStatus } = await import('@/lib/github-app/repo-status');
    await expect(getGitHubAppRepoStatus('company-a', 'acme/widgets')).resolves.toEqual({
      status: 'ready',
      installationId: 115918626,
    });
  });

  it('returns setup_incomplete when the owner has an active installation but the repo is not connected', async () => {
    mockGitHubAppInstallationFindFirst.mockResolvedValue({ installationId: 115918626 });

    const { getGitHubAppRepoStatus } = await import('@/lib/github-app/repo-status');
    await expect(getGitHubAppRepoStatus('company-a', 'acme/widgets')).resolves.toEqual({
      status: 'setup_incomplete',
      installationId: 115918626,
    });
  });

  it('returns not_installed when neither the repo nor the owner has an active installation', async () => {
    const { getGitHubAppRepoStatus } = await import('@/lib/github-app/repo-status');
    await expect(getGitHubAppRepoStatus('company-a', 'acme/widgets')).resolves.toEqual({
      status: 'not_installed',
      installationId: null,
    });
  });
});
