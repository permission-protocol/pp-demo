@@ -0,0 +1,75 @@
+import { rawPrisma as prisma } from '@/lib/company/raw-prisma';
+
+export type GitHubAppRepoStatus = 'not_installed' | 'setup_incomplete' | 'ready';
+
+export type GitHubAppRepoStatusResult = {
+  status: GitHubAppRepoStatus;
+  installationId: number | null;
+};
+
+function parseRepoOwner(repoFullName: string): string | null {
+  const [owner] = repoFullName.split('/');
+  return owner || null;
+}
+
+export async function getGitHubAppRepoStatus(
+  companyId: string,
+  repoFullName: string
+): Promise<GitHubAppRepoStatusResult> {
+  const repoRecord = await prisma.gitHubAppRepo.findFirst({
+    where: {
+      repoFullName,
+      status: 'connected',
+      installation: {
+        companyId,
+        status: 'active',
+      },
+    },
+    select: {
+      workflowInstalled: true,
+      secretInjected: true,
+      rulesetCreated: true,
+      installation: {
+        select: {
+          installationId: true,
+        },
+      },
+    },
+  });
+
+  if (repoRecord) {
+    const isReady =
+      repoRecord.workflowInstalled &&
+      repoRecord.secretInjected &&
+      repoRecord.rulesetCreated;
+    return {
+      status: isReady ? 'ready' : 'setup_incomplete',
+      installationId: repoRecord.installation.installationId,
+    };
+  }
+
+  const owner = parseRepoOwner(repoFullName);
+  if (!owner) {
+    return { status: 'not_installed', installationId: null };
+  }
+
+  const ownerInstallation = await prisma.gitHubAppInstallation.findFirst({
+    where: {
+      companyId,
+      accountLogin: owner,
+      status: 'active',
+    },
+    select: {
+      installationId: true,
+    },
+  });
+
+  if (!ownerInstallation) {
+    return { status: 'not_installed', installationId: null };
+  }
+
+  return {
+    status: 'setup_incomplete',
+    installationId: ownerInstallation.installationId,
+  };
+}
