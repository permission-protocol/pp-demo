export function RequestMetaRow({ label, value }: { label: string; value: ReactNode }) {
  return (
    <div className="grid gap-1 sm:grid-cols-[140px_minmax(0,1fr)] sm:items-start">
      <div className="text-xs uppercase tracking-[0.12em] text-[var(--muted)]">{label}</div>
      <div className="min-w-0 text-sm text-[var(--foreground)]">{value}</div>
    </div>
  );
}

export function ShimmerBlock({ className }: { className: string }) {
  return <div className={`animate-pulse rounded-md bg-[rgba(255,255,255,0.06)] ${className}`} />;
}
