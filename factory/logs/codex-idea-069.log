+
+const STORAGE_KEY = "pp-onboarding-progress";
+const COMPLETE_HIDE_DELAY_MS = 5_000;
+
+type StepId = "account" | "install-app" | "connect-repo" | "configure-policy" | "trigger-gate" | "review-request";
+
+type StoredProgress = {
+  completed?: StepId[];
+  collapsed?: boolean;
+  hidden?: boolean;
+};
+
+type StepDefinition = {
+  id: StepId;
+  title: string;
+  description: string;
+  href?: string;
+  external?: boolean;
+  actionLabel?: string;
+};
+
+type OnboardingChecklistProps = {
+  repos: string[];
+  hasRequests: boolean;
+};
+
+const steps: StepDefinition[] = [
+  {
+    id: "account",
+    title: "Create account",
+    description: "Your account is ready. Finish the remaining setup steps to activate your first deploy gate.",
+  },
+  {
+    id: "install-app",
+    title: "Install GitHub App",
+    description: "Install the Permission Protocol GitHub App so deploy requests can flow into the review queue.",
+    href: "https://github.com/apps/permission-protocol/installations/new",
+    external: true,
+    actionLabel: "Install App",
+  },
+  {
+    id: "connect-repo",
+    title: "Connect first repository",
+    description: "Grant the app access to the repository where you want deploy approvals enforced.",
+    href: "https://github.com/settings/installations",
+    external: true,
+    actionLabel: "Manage Repos",
+  },
+  {
+    id: "configure-policy",
+    title: "Configure first policy",
+    description: "Add your first approval rule so Permission Protocol knows which deploys require review.",
+    href: "/developers/quickstart",
+    actionLabel: "Open Quickstart",
+  },
+  {
+    id: "trigger-gate",
+    title: "Trigger first deploy gate",
+    description: "Open a PR or run your deploy workflow on a connected repo to generate the first review request.",
+    href: "/how-it-works",
+    actionLabel: "View Instructions",
+  },
+  {
+    id: "review-request",
+    title: "Review first request",
+    description: "Approve or deny your first request from this queue to complete the onboarding flow.",
+  },
+];
+
+function loadStoredProgress(): StoredProgress {
+  if (typeof window === "undefined") return {};
+  try {
+    const parsed = JSON.parse(window.localStorage.getItem(STORAGE_KEY) ?? "{}") as StoredProgress;
+    return parsed && typeof parsed === "object" ? parsed : {};
+  } catch {
+    return {};
+  }
+}
+
+function persistProgress(progress: StoredProgress) {
+  if (typeof window === "undefined") return;
+  window.localStorage.setItem(STORAGE_KEY, JSON.stringify(progress));
+}
+
+export function OnboardingChecklist({ repos, hasRequests }: OnboardingChecklistProps) {
+  const [storedProgress, setStoredProgress] = useState<StoredProgress>({});
+  const [hydrated, setHydrated] = useState(false);
+
+  useEffect(() => {
+    setStoredProgress(loadStoredProgress());
+    setHydrated(true);
+  }, []);
+
+  const completedStepSet = useMemo(() => {
+    const next = new Set<StepId>(["account"]);
+    for (const stepId of storedProgress.completed ?? []) {
+      next.add(stepId);
+    }
+    if (repos.length > 0) {
+      next.add("install-app");
+      next.add("connect-repo");
+    }
+    if (hasRequests) {
+      next.add("trigger-gate");
+      next.add("review-request");
+    }
+    return next;
+  }, [hasRequests, repos.length, storedProgress.completed]);
+
+  const completedCount = completedStepSet.size;
+  const isComplete = completedCount === steps.length;
+  const visibleSteps = steps.filter((step) => step.id !== "connect-repo" || completedStepSet.has("install-app"));
+
+  useEffect(() => {
+    if (!hydrated) return;
+    const nextProgress: StoredProgress = {
+      completed: Array.from(completedStepSet),
+      collapsed: storedProgress.collapsed ?? false,
+      hidden: storedProgress.hidden ?? false,
+    };
+    persistProgress(nextProgress);
+    setStoredProgress((current) => {
+      const currentCompleted = current.completed ?? [];
+      if (
+        currentCompleted.length === nextProgress.completed?.length &&
+        currentCompleted.every((stepId) => completedStepSet.has(stepId)) &&
+        current.collapsed === nextProgress.collapsed &&
+        current.hidden === nextProgress.hidden
+      ) {
+        return current;
+      }
+      return nextProgress;
+    });
+  }, [completedStepSet, hydrated, storedProgress.collapsed, storedProgress.hidden]);
+
+  useEffect(() => {
+    if (!hydrated || !isComplete || storedProgress.hidden) return;
+    const timer = window.setTimeout(() => {
+      const nextProgress: StoredProgress = {
+        completed: Array.from(completedStepSet),
+        collapsed: false,
+        hidden: true,
+      };
+      persistProgress(nextProgress);
+      setStoredProgress(nextProgress);
+    }, COMPLETE_HIDE_DELAY_MS);
+    return () => window.clearTimeout(timer);
+  }, [completedStepSet, hydrated, isComplete, storedProgress.hidden]);
+
+  if (!hydrated || storedProgress.hidden) {
+    return null;
+  }
+
+  const activeStepId = steps.find((step) => !completedStepSet.has(step.id))?.id;
+  const progressPercent = Math.round((completedCount / steps.length) * 100);
+
+  function toggleCollapsed() {
+    const nextProgress: StoredProgress = {
+      completed: Array.from(completedStepSet),
+      collapsed: !storedProgress.collapsed,
+      hidden: storedProgress.hidden ?? false,
+    };
+    persistProgress(nextProgress);
+    setStoredProgress(nextProgress);
+  }
+
+  function markStepComplete(stepId: StepId) {
+    const nextCompleted = new Set(completedStepSet);
+    nextCompleted.add(stepId);
+    const nextProgress: StoredProgress = {
+      completed: Array.from(nextCompleted),
+      collapsed: storedProgress.collapsed ?? false,
+      hidden: storedProgress.hidden ?? false,
+    };
+    persistProgress(nextProgress);
+    setStoredProgress(nextProgress);
+  }
+
+  return (
+    <section className="mb-6 rounded-2xl border border-border bg-card p-5 shadow-[0_18px_50px_rgba(0,0,0,0.22)]">
+      <div className="flex flex-col gap-4 sm:flex-row sm:items-start sm:justify-between">
+        <div className="min-w-0 flex-1">
+          <div className="flex items-center gap-2">
+            {isComplete ? <PartyPopper className="h-5 w-5 text-[#10B981]" /> : <CheckCircle2 className="h-5 w-5 text-permit" />}
+            <p className="text-sm font-semibold text-signal">
+              {isComplete ? "You're all set! 🎉" : "Get started with Permission Protocol"}
+            </p>
+          </div>
+          <p className="mt-1 text-sm text-secondary">
+            {isComplete ? "Your design partner workspace is configured and ready for real deploy reviews." : `${completedCount} of 6 steps complete`}
+          </p>
+          <div className="mt-4 h-2 overflow-hidden rounded-full bg-ash">
+            <div className="h-full rounded-full bg-permit transition-[width] duration-500 ease-out" style={{ width: `${progressPercent}%` }} />
+          </div>
+        </div>
+        <button
+          type="button"
+          onClick={toggleCollapsed}
+          className="inline-flex min-h-11 items-center justify-center gap-2 rounded-full border border-border bg-ash px-4 py-2 text-xs font-semibold uppercase tracking-[0.12em] text-secondary transition-colors hover:border-permit/40 hover:text-signal"
+          aria-expanded={!storedProgress.collapsed}
+        >
+          {storedProgress.collapsed ? "Expand" : "Collapse"}
+          {storedProgress.collapsed ? <ChevronDown className="h-4 w-4" /> : <ChevronUp className="h-4 w-4" />}
+        </button>
+      </div>
+
+      {!storedProgress.collapsed ? (
+        <div className="mt-5 grid gap-3">
+          {visibleSteps.map((step, index) => {
+            const complete = completedStepSet.has(step.id);
+            const active = !complete && activeStepId === step.id;
+
+            return (
+              <div
+                key={step.id}
+                className={`rounded-xl border px-4 py-4 transition-colors ${
+                  active ? "border-permit/60 bg-permit/10" : complete ? "border-[#10B981]/40 bg-[rgba(16,185,129,0.08)]" : "border-border bg-ash/70"
+                }`}
+              >
+                <div className="flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
+                  <div className="min-w-0 flex-1">
+                    <div className="flex items-start gap-3">
+                      <span
+                        className={`mt-0.5 inline-flex h-6 w-6 shrink-0 items-center justify-center rounded-full border ${
+                          complete ? "border-[#10B981]/60 bg-[#10B981]/15 text-[#10B981]" : active ? "border-permit bg-permit/15 text-permit" : "border-border text-muted"
+                        }`}
+                      >
+                        {complete ? <CheckCircle2 className="h-4 w-4" /> : <span className="text-[11px] font-semibold">{index + 1}</span>}
+                      </span>
+                      <div className="min-w-0">
+                        <p className={`text-sm font-semibold ${complete || active ? "text-signal" : "text-secondary"}`}>{step.title}</p>
+                        <p className="mt-1 text-sm text-secondary">{step.description}</p>
+                      </div>
+                    </div>
+                  </div>
+                  {step.href && step.actionLabel && !complete ? (
+                    step.external ? (
+                      <a
+                        href={step.href}
+                        target="_blank"
+                        rel="noopener noreferrer"
+                        onClick={() => markStepComplete(step.id)}
+                        className="inline-flex min-h-11 items-center justify-center gap-2 rounded-lg border border-permit/40 bg-permit/10 px-4 py-2 text-sm font-semibold text-permit transition-colors hover:border-permit hover:bg-permit/15"
+                      >
+                        {step.actionLabel}
+                        <ExternalLink className="h-4 w-4" />
+                      </a>
+                    ) : (
