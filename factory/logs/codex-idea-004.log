+function parseReviewEnrichment(raw: string | null): ReviewEnrichment | null {
+  if (!raw) {
+    return null;
+  }
+
+  try {
+    const parsed = JSON.parse(raw) as Partial<ReviewEnrichment>;
+    if (
+      typeof parsed.summary === 'string' &&
+      typeof parsed.generatedAt === 'string' &&
+      parsed.diff &&
+      typeof parsed.diff === 'object' &&
+      Array.isArray(parsed.diff.files) &&
+      Array.isArray(parsed.riskSignals)
+    ) {
+      return parsed as ReviewEnrichment;
+    }
+  } catch (error) {
+    console.warn('[verify] Failed to parse deploy request enrichment JSON', {
+      error: error instanceof Error ? error.message : error,
+      rawLength: raw.length,
+    });
+  }
+
+  return null;
+}
+
+function getEnrichmentRiskLevel(
+  signals: ReviewEnrichment['riskSignals']
+): 'critical' | 'high' | 'medium' | 'low' {
+  if (signals.some((signal) => signal.severity === 'critical')) {
+    return 'critical';
+  }
+  if (signals.some((signal) => signal.severity === 'high')) {
+    return 'high';
+  }
+  if (signals.some((signal) => signal.severity === 'medium')) {
+    return 'medium';
+  }
+  return 'low';
+}
