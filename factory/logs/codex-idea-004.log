+export function categorizeFileRisk(
+  filename: string,
+  signals: RiskSignal[]
+): 'critical' | 'standard' | 'low' {
+  const matchingSignals = signals.filter((signal) => signal.files.includes(filename));
+
+  if (matchingSignals.some((signal) => signal.severity === 'critical' || signal.severity === 'high')) {
+    return 'critical';
+  }
+
+  if (matchingSignals.length > 0) {
+    return 'standard';
+  }
+
+  return 'low';
+}
