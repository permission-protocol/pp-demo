+export type ReviewRequest = {
+  id: string;
+  repo: string;
+  prTitle: string;
+  riskTier: "low" | "standard" | "high";
+  environment: string;
+  author: string;
+  requestedAt: string;
+  summary: string;
+  status: "pending";
+};
+
+const baseRequests: ReviewRequest[] = [
+  {
+    id: "rev_2031",
+    repo: "permission-protocol/site",
+    prTitle: "Roll out mobile approval shell and deploy gate copy refresh",
+    riskTier: "standard",
+    environment: "production",
+    author: "deploy-bot",
+    requestedAt: "2026-03-03T10:12:00Z",
+    summary: "Homepage copy update, mobile queue styling polish, and release pipeline metadata changes.",
+    status: "pending"
+  },
+  {
+    id: "rev_2032",
+    repo: "permission-protocol/api",
+    prTitle: "Enable deploy approval receipt verification for prod jobs",
+    riskTier: "high",
+    environment: "production",
+    author: "release-agent",
+    requestedAt: "2026-03-03T10:24:00Z",
+    summary: "Touches receipt verification, production deploy policy enforcement, and audit logging.",
+    status: "pending"
+  }
+];
+
+const timedRequest: ReviewRequest = {
+  id: "rev_2033",
+  repo: "permission-protocol/sdk-js",
+  prTitle: "Ship CLI receipt replay for hotfix workflow",
+  riskTier: "low",
+  environment: "staging",
+  author: "ops-agent",
+  requestedAt: "2026-03-03T10:30:00Z",
+  summary: "Adds CLI replay support for staged deploys and receipt inspection during hotfix drills.",
+  status: "pending"
+};
+
+export function getReviewRequests(now = new Date()): ReviewRequest[] {
+  const requests = [...baseRequests];
+
+  if (now.getUTCMinutes() % 2 === 1) {
+    requests.push(timedRequest);
+  }
+
+  return requests;
+}

codex
Implemented the Phase 3 PWA/mobile review flow.

The main changes are in [app/layout.tsx](/Users/moltbot/pp-agent-work/factory-idea-071/app/layout.tsx#L21), which now wires in the manifest, Apple PWA metadata, service worker registration, the offline indicator, and the mobile install prompt. The install UX and offline banner live in [src/components/InstallPrompt.tsx](/Users/moltbot/pp-agent-work/factory-idea-071/src/components/InstallPrompt.tsx#L12), [src/components/OfflineIndicator.tsx](/Users/moltbot/pp-agent-work/factory-idea-071/src/components/OfflineIndicator.tsx#L5), and [src/components/ServiceWorkerRegistrar.tsx](/Users/moltbot/pp-agent-work/factory-idea-071/src/components/ServiceWorkerRegistrar.tsx#L5). The PWA assets are in [public/manifest.json](/Users/moltbot/pp-agent-work/factory-idea-071/public/manifest.json), [public/sw.js](/Users/moltbot/pp-agent-work/factory-idea-071/public/sw.js#L1), [public/offline.html](/Users/moltbot/pp-agent-work/factory-idea-071/public/offline.html), and the new icons under `/public/icons/`.

The new review dashboard is at [app/review/page.tsx](/Users/moltbot/pp-agent-work/factory-idea-071/app/review/page.tsx) with behavior in [app/review/ReviewDashboard.tsx](/Users/moltbot/pp-agent-work/factory-idea-071/app/review/ReviewDashboard.tsx#L54). It prompts for notification permission with the required copy, stores the push subscription endpoint in `localStorage`, polls `/api/reviews` every 60 seconds, and shows local notifications for newly seen pending requests while the page is in the background. The MVP review data/API are in [src/lib/reviewData.ts](/Users/moltbot/pp-agent-work/factory-idea-071/src/lib/reviewData.ts#L1) and [app/api/reviews/route.ts](/Users/moltbot/pp-agent-work/factory-idea-071/app/api/reviews/route.ts#L1).

