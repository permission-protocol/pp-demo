+++ b/app/review/ReviewDashboard.tsx
@@ -0,0 +1,266 @@
+"use client";
+
+import { useEffect, useRef, useState } from "react";
+import Link from "next/link";
+import type { ReviewRequest } from "@/src/lib/reviewData";
+
+const NOTIFICATION_ENDPOINT_KEY = "pp-push-subscription-endpoint";
+const SEEN_REQUESTS_KEY = "pp-seen-review-requests";
+const VAPID_PUBLIC_KEY = "BDxQpyTln1dWnopnrg3ypZfWlf4eGYNDGbFs8IfYc-dvRjHMWK3OGwhSew6kBqXp51aYaR7qvd2SjlvU2MyIm6w";
+
+type ReviewsResponse = {
+  requests: ReviewRequest[];
+  generatedAt: string;
+};
+
+function urlBase64ToUint8Array(base64String: string) {
+  const padding = "=".repeat((4 - (base64String.length % 4)) % 4);
+  const base64 = (base64String + padding).replace(/-/g, "+").replace(/_/g, "/");
+  const rawData = window.atob(base64);
+
+  return Uint8Array.from(rawData, (char) => char.charCodeAt(0));
+}
+
+async function storePushSubscription() {
+  if (!("serviceWorker" in navigator) || !("PushManager" in window)) {
+    return;
+  }
+
+  const registration = await navigator.serviceWorker.ready;
+  let subscription = await registration.pushManager.getSubscription();
+
+  if (!subscription) {
+    subscription = await registration.pushManager.subscribe({
+      userVisibleOnly: true,
+      applicationServerKey: urlBase64ToUint8Array(VAPID_PUBLIC_KEY)
+    });
+  }
+
+  window.localStorage.setItem(NOTIFICATION_ENDPOINT_KEY, subscription.endpoint);
+}
+
+function riskClasses(riskTier: ReviewRequest["riskTier"]) {
+  if (riskTier === "high") {
+    return "border-red-500/35 bg-red-500/10 text-red-200";
+  }
+
+  if (riskTier === "standard") {
+    return "border-amber-500/35 bg-amber-500/10 text-amber-200";
+  }
+
+  return "border-emerald-500/35 bg-emerald-500/10 text-emerald-200";
+}
+
+export function ReviewDashboard() {
+  const [requests, setRequests] = useState<ReviewRequest[]>([]);
+  const [loading, setLoading] = useState(true);
+  const [error, setError] = useState<string | null>(null);
+  const [permission, setPermission] = useState<NotificationPermission>("default");
+  const [permissionState, setPermissionState] = useState<"idle" | "working" | "done" | "error">("idle");
+  const initializedRef = useRef(false);
+
+  useEffect(() => {
+    if (!("Notification" in window)) {
+      return;
+    }
+
+    setPermission(Notification.permission);
+  }, []);
+
+  useEffect(() => {
+    let cancelled = false;
+
+    const poll = async () => {
+      try {
+        const response = await fetch("/api/reviews", { cache: "no-store" });
+        if (!response.ok) {
+          throw new Error("Unable to load review requests.");
+        }
+
+        const data = (await response.json()) as ReviewsResponse;
+        if (cancelled) {
+          return;
+        }
+
+        setRequests(data.requests);
+        setError(null);
+
+        const nextIds = data.requests.map((request) => request.id);
+        const seen = new Set<string>(
+          JSON.parse(window.localStorage.getItem(SEEN_REQUESTS_KEY) ?? "[]") as string[]
+        );
+
+        if (!initializedRef.current) {
+          window.localStorage.setItem(SEEN_REQUESTS_KEY, JSON.stringify(nextIds));
+          initializedRef.current = true;
+        } else {
+          const newRequests = data.requests.filter((request) => !seen.has(request.id));
+          newRequests.forEach((request) => seen.add(request.id));
+          window.localStorage.setItem(SEEN_REQUESTS_KEY, JSON.stringify([...seen]));
+
+          if (
+            "Notification" in window &&
+            document.hidden &&
+            Notification.permission === "granted" &&
+            newRequests.length > 0
+          ) {
+            const registration = await navigator.serviceWorker.ready;
+            await Promise.all(
+              newRequests.map((request) =>
+                registration.showNotification("Deploy request needs approval", {
+                  body: `${request.repo} — ${request.prTitle} (${request.riskTier})`,
+                  icon: "/icons/icon-192.png",
+                  badge: "/icons/icon-192.png",
+                  data: { url: `/review?request=${request.id}` }
+                })
+              )
+            );
+          }
+        }
+      } catch (nextError) {
+        if (!cancelled) {
+          setError(nextError instanceof Error ? nextError.message : "Unable to load review requests.");
+        }
+      } finally {
+        if (!cancelled) {
+          setLoading(false);
+        }
+      }
+    };
+
+    void poll();
+    const interval = window.setInterval(() => {
+      void poll();
+    }, 60_000);
+
+    return () => {
+      cancelled = true;
+      window.clearInterval(interval);
+    };
+  }, []);
+
+  const requestPermission = async () => {
+    if (!("Notification" in window)) {
+      setPermissionState("error");
+      return;
+    }
+
+    setPermissionState("working");
+
+    try {
+      const nextPermission = await Notification.requestPermission();
+      setPermission(nextPermission);
+
+      if (nextPermission !== "granted") {
+        setPermissionState("error");
+        return;
+      }
+
+      await storePushSubscription();
+      setPermissionState("done");
+    } catch {
+      setPermissionState("error");
+    }
+  };
+
+  return (
+    <div className="section-shell pb-16 pt-28">
+      <div className="mx-auto max-w-5xl">
+        <div className="flex flex-col gap-4 rounded-[2rem] border border-border bg-card/80 p-6 shadow-2xl shadow-black/20">
+          <p className="text-xs uppercase tracking-[0.2em] text-permit">Mobile Review Queue</p>
+          <div className="flex flex-col gap-3 md:flex-row md:items-end md:justify-between">
+            <div>
+              <h1 className="text-4xl font-semibold text-signal">Deploy approvals, ready for home screen.</h1>
+              <p className="mt-3 max-w-2xl text-sm text-secondary">
+                Cached review queue, local approval alerts, and a standalone install path for mobile responders.
+              </p>
+            </div>
+            <div className="rounded-2xl border border-border bg-ash/70 px-4 py-3 text-sm text-secondary">
+              Polling <span className="font-medium text-signal">/api/reviews</span> every 60 seconds
+            </div>
+          </div>
+        </div>
+
+        {permission !== "granted" ? (
+          <section className="mt-6 rounded-[1.75rem] border border-permit/35 bg-permit/10 p-5">
+            <p className="text-xs uppercase tracking-[0.18em] text-permit">Notifications</p>
+            <h2 className="mt-2 text-2xl font-semibold text-signal">
+              Get notified when deploy requests need your approval?
+            </h2>
+            <p className="mt-3 max-w-2xl text-sm text-secondary">
+              Permission Protocol stores the local push subscription endpoint on this device for the Phase 3 MVP.
+            </p>
+            <div className="mt-4 flex flex-wrap items-center gap-3">
+              <button type="button" onClick={requestPermission} className="btn-primary px-4 py-2 text-sm">
+                {permissionState === "working" ? "Requesting..." : "Enable notifications"}
+              </button>
+              <p className="text-xs text-secondary">
+                {permissionState === "done"
+                  ? "Notifications enabled for this device."
+                  : permissionState === "error"
+                    ? "Notifications were not enabled. You can retry from this screen."
+                    : "Android Chrome and iOS 16.4+ Safari support web push."}
+              </p>
+            </div>
+          </section>
+        ) : null}
+
+        <section className="mt-6 grid gap-4">
+          {loading ? (
+            <div className="rounded-[1.75rem] border border-border bg-card/75 p-6 text-secondary">
+              Loading pending requests...
+            </div>
+          ) : null}
+
+          {error ? (
+            <div className="rounded-[1.75rem] border border-red-500/35 bg-red-500/10 p-6 text-red-100">{error}</div>
+          ) : null}
+
+          {!loading && !error && requests.length === 0 ? (
+            <div className="rounded-[1.75rem] border border-border bg-card/75 p-6 text-secondary">
+              No pending review requests.
+            </div>
+          ) : null}
+
+          {requests.map((request) => (
+            <article key={request.id} className="rounded-[1.75rem] border border-border bg-card/80 p-5">
+              <div className="flex flex-col gap-4 md:flex-row md:items-start md:justify-between">
+                <div className="min-w-0">
+                  <div className="flex flex-wrap items-center gap-2">
+                    <span className="rounded-full border border-border bg-ash/70 px-3 py-1 text-[11px] uppercase tracking-[0.16em] text-secondary">
+                      {request.repo}
+                    </span>
+                    <span className={`rounded-full border px-3 py-1 text-[11px] uppercase tracking-[0.16em] ${riskClasses(request.riskTier)}`}>
+                      {request.riskTier} risk
+                    </span>
+                  </div>
+                  <h2 className="mt-3 text-2xl font-semibold text-signal">{request.prTitle}</h2>
+                  <p className="mt-2 max-w-2xl text-sm text-secondary">{request.summary}</p>
+                </div>
+                <div className="rounded-2xl border border-border bg-ash/60 px-4 py-3 text-sm text-secondary">
+                  <p>
+                    Env: <span className="font-medium text-signal">{request.environment}</span>
+                  </p>
+                  <p className="mt-1">
+                    Actor: <span className="font-medium text-signal">{request.author}</span>
+                  </p>
+                </div>
+              </div>
+              <div className="mt-5 flex flex-wrap items-center gap-3">
+                <button type="button" className="btn-primary px-4 py-2 text-sm">
+                  Approve
+                </button>
+                <button type="button" className="btn-secondary px-4 py-2 text-sm">
+                  Deny
+                </button>
+                <Link href={`/review?request=${request.id}`} className="text-sm font-semibold text-permit">
+                  Open review
+                </Link>
+              </div>
+            </article>
+          ))}
+        </section>
+      </div>
+    </div>
+  );
+}
