+export type ReviewRequest = {
+  id: string;
+  repo: string;
+  prTitle: string;
+  riskTier: "low" | "standard" | "high";
+  environment: string;
+  author: string;
+  requestedAt: string;
+  summary: string;
+  status: "pending";
+};
+
+const baseRequests: ReviewRequest[] = [
+  {
+    id: "rev_2031",
+    repo: "permission-protocol/site",
+    prTitle: "Roll out mobile approval shell and deploy gate copy refresh",
+    riskTier: "standard",
+    environment: "production",
+    author: "deploy-bot",
+    requestedAt: "2026-03-03T10:12:00Z",
+    summary: "Homepage copy update, mobile queue styling polish, and release pipeline metadata changes.",
+    status: "pending"
+  },
+  {
+    id: "rev_2032",
+    repo: "permission-protocol/api",
+    prTitle: "Enable deploy approval receipt verification for prod jobs",
+    riskTier: "high",
+    environment: "production",
+    author: "release-agent",
+    requestedAt: "2026-03-03T10:24:00Z",
+    summary: "Touches receipt verification, production deploy policy enforcement, and audit logging.",
+    status: "pending"
+  }
+];
+
+const timedRequest: ReviewRequest = {
+  id: "rev_2033",
+  repo: "permission-protocol/sdk-js",
+  prTitle: "Ship CLI receipt replay for hotfix workflow",
+  riskTier: "low",
+  environment: "staging",
+  author: "ops-agent",
+  requestedAt: "2026-03-03T10:30:00Z",
+  summary: "Adds CLI replay support for staged deploys and receipt inspection during hotfix drills.",
+  status: "pending"
+};
+
+export function getReviewRequests(now = new Date()): ReviewRequest[] {
+  const requests = [...baseRequests];
+
+  if (now.getUTCMinutes() % 2 === 1) {
+    requests.push(timedRequest);
+  }
+
+  return requests;
+}


