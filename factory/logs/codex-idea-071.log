@@ -0,0 +1,34 @@
+"use client";
+
+import { useEffect, useState } from "react";
+
+export function OfflineIndicator() {
+  const [isOffline, setIsOffline] = useState(false);
+
+  useEffect(() => {
+    const updateStatus = () => setIsOffline(!navigator.onLine);
+
+    updateStatus();
+    window.addEventListener("online", updateStatus);
+    window.addEventListener("offline", updateStatus);
+
+    return () => {
+      window.removeEventListener("online", updateStatus);
+      window.removeEventListener("offline", updateStatus);
+    };
+  }, []);
+
+  return (
+    <div
+      className={`fixed inset-x-0 top-0 z-[70] flex justify-center px-4 transition-transform duration-200 ${
+        isOffline ? "translate-y-0" : "-translate-y-full"
+      }`}
+      aria-live="polite"
+      role="status"
+    >
+      <div className="mt-2 rounded-full border border-amber-500/40 bg-amber-500/15 px-4 py-2 text-sm font-medium text-amber-200 shadow-lg shadow-amber-950/20">
+        You&apos;re offline
+      </div>
+    </div>
+  );
+}
