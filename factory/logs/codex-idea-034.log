+  if (cached.expiresAt <= Date.now()) {
+    previewUrlCache.delete(getCacheKey(companyId, requestId));
+    return null;
+  }
+  return cached.payload;
+}
+
+export function setCachedPreviewUrl(companyId: string, requestId: string, payload: PreviewUrlResponse): void {
+  previewUrlCache.set(getCacheKey(companyId, requestId), {
+    expiresAt: Date.now() + CACHE_TTL_MS,
+    payload,
+  });
+}
+
+export function invalidateCachedPreviewUrl(companyId: string, requestId: string): void {
+  previewUrlCache.delete(getCacheKey(companyId, requestId));
+}
