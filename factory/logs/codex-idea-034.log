+  const [expanded, setExpanded] = useState(true);
+
+  useEffect(() => {
+    let cancelled = false;
+
+    const loadPreview = async () => {
+      setPreview(null);
+      setError(null);
+      try {
+        const response = await fetch(`/api/v1/deploy-requests/${requestId}/preview-url`);
+        const data = (await response.json()) as VisualPreviewData & {
+          error?: { message?: string };
+        };
+        if (!response.ok) {
+          throw new Error(data?.error?.message || 'Failed to load preview');
+        }
+        if (!cancelled) {
+          setPreview(data);
+        }
+      } catch (err) {
+        if (!cancelled) {
+          setPreview(null);
+          setError(err instanceof Error ? err.message : 'Failed to load preview');
+        }
+      }
+    };
