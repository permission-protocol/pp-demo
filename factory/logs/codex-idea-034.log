+import { NextResponse } from 'next/server';
+import { withTenant } from '@/lib/auth/require-tenant';
+import { rawPrisma as prisma } from '@/lib/company/raw-prisma';
+import { getAppTokenForRepo } from '@/lib/github-app/installation-token';
+import { httpError, ErrorCodes } from '@/lib/http/errors';
+import {
+  getCachedPreviewUrl,
+  invalidateCachedPreviewUrl,
+  setCachedPreviewUrl,
+  type PreviewUrlResponse,
+} from './cache';
+
+export const dynamic = 'force-dynamic';
+
+const GITHUB_API_VERSION = '2022-11-28';
+
+type GitHubDeployment = {
+  id?: number;
+  environment?: string | null;
+};
+
+type GitHubDeploymentStatus = {
+  state?: string | null;
+  environment?: string | null;
+  environment_url?: string | null;
+};
+
+function parseRepoFullName(repo: string): { owner: string; repo: string } | null {
+  const [owner, name] = repo.split('/');
+  if (!owner || !name) {
+    return null;
+  }
+  return { owner, repo: name };
+}
+
+function getGitHubHeaders(token: string): HeadersInit {
+  return {
+    Authorization: `Bearer ${token}`,
+    Accept: 'application/vnd.github+json',
+    'Content-Type': 'application/json',
+    'X-GitHub-Api-Version': GITHUB_API_VERSION,
+  };
+}
+
+async function safeJson<T>(response: Response): Promise<T | null> {
+  try {
+    return (await response.json()) as T;
+  } catch {
+    return null;
+  }
+}
+
+async function readGitHubError(response: Response): Promise<string> {
+  const payload = await safeJson<{ message?: string }>(response);
+  return payload?.message ?? `GitHub API returned ${response.status}`;
+}
+
+function isPreviewStatus(status: GitHubDeploymentStatus): boolean {
+  const environment = status.environment?.toLowerCase() ?? '';
+  const environmentUrl = status.environment_url?.toLowerCase() ?? '';
+  return environmentUrl.includes('vercel.app') || environment === 'preview';
+}
+
+function isBuildingState(state: string | null | undefined): boolean {
+  return state === 'pending' || state === 'in_progress' || state === 'queued';
+}
+
+function getResolvedPreviewStatus(
+  statuses: GitHubDeploymentStatus[],
+  deploymentEnvironment: string | null | undefined
+): PreviewUrlResponse {
+  for (const status of statuses) {
+    if (status.environment_url && isPreviewStatus(status)) {
+      return {
+        previewUrl: status.environment_url,
+        status: 'ready',
+      };
+    }
+  }
+
+  const deploymentLooksLikePreview = (deploymentEnvironment?.toLowerCase() ?? '') === 'preview';
+  const isBuilding = statuses.some((status) => isPreviewStatus(status) || deploymentLooksLikePreview)
+    ? statuses.some((status) => isBuildingState(status.state))
+    : false;
+
+  return {
+    previewUrl: null,
+    status: isBuilding ? 'building' : 'not_found',
+  };
+}
+
+export const GET = withTenant<{ requestId: string }>(async (_request, { params }, { companyId }) => {
+  const { requestId } = await params;
+
+  const deployRequest = await prisma.deployGateRequest.findFirst({
+    where: {
+      id: requestId,
+      companyId,
+    },
+    select: {
+      id: true,
+      repo: true,
+      headSha: true,
+      commitSha: true,
+    },
+  });
+
+  if (!deployRequest) {
+    return httpError(ErrorCodes.NOT_FOUND, 'Deploy request not found');
+  }
+
+  const cached = getCachedPreviewUrl(companyId, requestId);
+  if (cached) {
+    return NextResponse.json(cached);
+  }
+
+  const sha = deployRequest.headSha ?? deployRequest.commitSha ?? null;
+  if (!sha) {
+    const payload: PreviewUrlResponse = { previewUrl: null, status: 'not_found' };
+    setCachedPreviewUrl(companyId, requestId, payload);
+    return NextResponse.json(payload);
+  }
+
+  const repo = parseRepoFullName(deployRequest.repo);
+  if (!repo) {
+    return httpError(ErrorCodes.VALIDATION_ERROR, `Invalid repo format: ${deployRequest.repo}`);
+  }
+
+  const appToken = await getAppTokenForRepo(deployRequest.repo);
+  const githubToken = appToken ?? process.env.GITHUB_TOKEN;
+  if (!githubToken) {
+    return httpError(ErrorCodes.INTERNAL_ERROR, 'GITHUB_TOKEN is not configured');
+  }
+
+  const headers = getGitHubHeaders(githubToken);
+
+  try {
+    const deploymentsResponse = await fetch(
+      `https://api.github.com/repos/${repo.owner}/${repo.repo}/deployments?sha=${encodeURIComponent(sha)}&per_page=5`,
+      { headers, cache: 'no-store' }
+    );
+
+    if (!deploymentsResponse.ok) {
+      throw new Error(await readGitHubError(deploymentsResponse));
+    }
+
+    const deployments = (await safeJson<GitHubDeployment[]>(deploymentsResponse)) ?? [];
+
+    let sawBuildingPreview = false;
+
+    for (const deployment of deployments) {
+      if (!deployment.id) {
+        continue;
+      }
+
+      const statusesResponse = await fetch(
+        `https://api.github.com/repos/${repo.owner}/${repo.repo}/deployments/${deployment.id}/statuses`,
+        { headers, cache: 'no-store' }
+      );
+
+      if (!statusesResponse.ok) {
+        throw new Error(await readGitHubError(statusesResponse));
+      }
+
+      const statuses = (await safeJson<GitHubDeploymentStatus[]>(statusesResponse)) ?? [];
+      const resolved = getResolvedPreviewStatus(statuses, deployment.environment);
+      if (resolved.status === 'ready') {
+        setCachedPreviewUrl(companyId, requestId, resolved);
+        return NextResponse.json(resolved);
+      }
+      if (resolved.status === 'building') {
+        sawBuildingPreview = true;
+      }
+    }
+
+    const payload: PreviewUrlResponse = {
+      previewUrl: null,
+      status: sawBuildingPreview ? 'building' : 'not_found',
+    };
+    setCachedPreviewUrl(companyId, requestId, payload);
+    return NextResponse.json(payload);
+  } catch (error) {
+    invalidateCachedPreviewUrl(companyId, requestId);
+    const message = error instanceof Error ? error.message : 'Failed to fetch preview URL';
+    return httpError(ErrorCodes.INTERNAL_ERROR, message);
+  }
+});
