diff --git a/src/app/api/v1/deploy-requests/[requestId]/preview-url/cache.ts b/src/app/api/v1/deploy-requests/[requestId]/preview-url/cache.ts
new file mode 100644
index 0000000000000000000000000000000000000000..358d5bcd60a5253dfcbdebb091fc48a50d07a5a3
--- /dev/null
+++ b/src/app/api/v1/deploy-requests/[requestId]/preview-url/cache.ts
@@ -0,0 +1,41 @@
+type PreviewStatus = 'ready' | 'building' | 'not_found';
+
+export type PreviewUrlResponse = {
+  previewUrl: string | null;
+  status: PreviewStatus;
+};
+
+type CacheEntry = {
+  expiresAt: number;
+  payload: PreviewUrlResponse;
+};
+
+const previewUrlCache = new Map<string, CacheEntry>();
+const CACHE_TTL_MS = 30_000;
+
+function getCacheKey(companyId: string, requestId: string): string {
+  return `${companyId}:${requestId}`;
+}
+
+export function getCachedPreviewUrl(companyId: string, requestId: string): PreviewUrlResponse | null {
+  const cached = previewUrlCache.get(getCacheKey(companyId, requestId));
+  if (!cached) {
+    return null;
+  }
+  if (cached.expiresAt <= Date.now()) {
+    previewUrlCache.delete(getCacheKey(companyId, requestId));
+    return null;
+  }
+  return cached.payload;
+}
+
+export function setCachedPreviewUrl(companyId: string, requestId: string, payload: PreviewUrlResponse): void {
+  previewUrlCache.set(getCacheKey(companyId, requestId), {
+    expiresAt: Date.now() + CACHE_TTL_MS,
+    payload,
+  });
+}
+
+export function invalidateCachedPreviewUrl(companyId: string, requestId: string): void {
+  previewUrlCache.delete(getCacheKey(companyId, requestId));
+}
diff --git a/src/app/api/v1/deploy-requests/[requestId]/preview-url/route.ts b/src/app/api/v1/deploy-requests/[requestId]/preview-url/route.ts
new file mode 100644
index 0000000000000000000000000000000000000000..a4f08ed9dd86ce373c6b903af1cd9551fb87f104
