+type VisualPreviewData = {
+  previewUrl: string | null;
+  status: 'ready' | 'building' | 'not_found';
+};
+
+function VisualPreview({
+  requestId,
+  prUrl,
+}: {
+  requestId: string;
+  prUrl?: string | null;
+}) {
+  const [preview, setPreview] = useState<VisualPreviewData | null>(null);
+  const [error, setError] = useState<string | null>(null);
+  const [expanded, setExpanded] = useState(true);
+
+  useEffect(() => {
+    let cancelled = false;
+
+    const loadPreview = async () => {
+      setPreview(null);
+      setError(null);
+      try {
+        const response = await fetch(`/api/v1/deploy-requests/${requestId}/preview-url`);
+        const data = (await response.json()) as VisualPreviewData & {
+          error?: { message?: string };
+        };
+        if (!response.ok) {
+          throw new Error(data?.error?.message || 'Failed to load preview');
+        }
+        if (!cancelled) {
+          setPreview(data);
+        }
+      } catch (err) {
+        if (!cancelled) {
+          setPreview(null);
+          setError(err instanceof Error ? err.message : 'Failed to load preview');
+        }
+      }
+    };
+
+    void loadPreview();
+
+    return () => {
+      cancelled = true;
+    };
+  }, [requestId]);
+
+  return (
+    <Card className="rounded-3xl border-[var(--border)] bg-[var(--card)]">
+      <CardHeader className="pb-3">
+        <div className="flex flex-wrap items-center justify-between gap-3">
+          <div>
+            <CardTitle className="text-white">Visual Preview</CardTitle>
+            <CardDescription>
+              Live Vercel preview for this deploy request.
+            </CardDescription>
+          </div>
+          <div className="flex items-center gap-2">
+            {preview?.status === 'ready' && preview.previewUrl ? (
+              <a
+                href={preview.previewUrl}
+                target="_blank"
+                rel="noreferrer"
+                className="inline-flex items-center gap-1 text-sm text-blue-300 transition-colors hover:text-blue-200"
+              >
+                Open in new tab
+                <ExternalLink className="h-3.5 w-3.5" />
+              </a>
+            ) : null}
+            <Button
+              type="button"
+              variant="secondary"
+              onClick={() => setExpanded((current) => !current)}
+              className="rounded-2xl"
+            >
+              {expanded ? <ChevronDown className="h-4 w-4" /> : <ChevronRight className="h-4 w-4" />}
+              {expanded ? 'Collapse' : 'Expand'}
+            </Button>
+          </div>
+        </div>
+      </CardHeader>
+      {expanded ? (
+        <CardContent className="space-y-4">
+          {!preview && !error ? (
+            <ShimmerBlock className="h-[350px] rounded-2xl md:h-[500px]" />
+          ) : null}
+
+          {error ? (
+            <div className="rounded-2xl border border-[#EF4444]/30 bg-[#EF4444]/10 px-4 py-3 text-sm text-red-200">
+              {error}
+            </div>
+          ) : null}
+
+          {preview?.status === 'ready' && preview.previewUrl ? (
+            <div className="space-y-3">
+              <iframe
+                title="Deploy request visual preview"
+                src={preview.previewUrl}
+                className="h-[350px] w-full rounded-2xl border border-[var(--border)] bg-black md:h-[500px]"
+              />
+            </div>
+          ) : null}
+
+          {preview?.status === 'building' ? (
+            <div className="flex h-[350px] items-center justify-center rounded-2xl border border-[var(--border)] bg-[var(--background)]/70 text-sm text-[var(--foreground)] md:h-[500px]">
+              <span className="inline-flex items-center gap-2">
+                <RefreshCw className="h-4 w-4 animate-spin text-blue-300" />
+                <span className="animate-pulse">Preview deploying...</span>
+              </span>
+            </div>
+          ) : null}
+
+          {preview?.status === 'not_found' ? (
+            <div className="flex h-[350px] flex-col items-center justify-center gap-3 rounded-2xl border border-[var(--border)] bg-[var(--background)]/70 px-6 text-center text-sm text-[var(--muted)] md:h-[500px]">
+              <span>No preview available.</span>
+              {prUrl ? (
+                <a
+                  href={prUrl}
+                  target="_blank"
+                  rel="noreferrer"
+                  className="inline-flex items-center gap-1 text-blue-300 transition-colors hover:text-blue-200"
+                >
+                  Check the PR
+                  <ExternalLink className="h-3.5 w-3.5" />
+                </a>
+              ) : null}
+            </div>
+          ) : null}
+        </CardContent>
+      ) : null}
+    </Card>
+  );
+}
