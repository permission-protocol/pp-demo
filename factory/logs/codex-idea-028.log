import { beforeEach, describe, expect, it, vi } from 'vitest';
import { NextRequest } from 'next/server';

const mockFindFirst = vi.fn();
const mockGetAppTokenForRepo = vi.fn();

vi.mock('@/lib/auth/require-tenant', () => ({
  withTenant: (handler: any) => async (request: NextRequest, context: any) =>
    handler(request, context, { companyId: 'company-a' }),
}));

vi.mock('@/lib/company/raw-prisma', () => ({
  rawPrisma: {
    deployGateRequest: {
      findFirst: (...args: unknown[]) => mockFindFirst(...args),
    },
  },
}));

vi.mock('@/lib/github-app/installation-token', () => ({
  getAppTokenForRepo: (...args: unknown[]) => mockGetAppTokenForRepo(...args),
}));

describe('merge readiness route', () => {
  beforeEach(() => {
    vi.resetModules();
    vi.clearAllMocks();

    mockFindFirst.mockResolvedValue({
      id: 'req-1',
      repo: 'acme/widgets',
      prNumber: 123,
    });

    process.env.GITHUB_TOKEN = 'pat-token';
  });

  it('prefers the GitHub App installation token when available', async () => {
    mockGetAppTokenForRepo.mockResolvedValue('app-token');

    global.fetch = vi
      .fn(async (input: RequestInfo | URL, init?: RequestInit) => {
        expect(String(input)).toContain('/repos/acme/widgets/pulls/123');
        expect((init?.headers as Record<string, string>).Authorization).toBe('Bearer app-token');

        return new Response(
          JSON.stringify({
            mergeable: true,
            mergeable_state: 'clean',
            merge_commit_sha: 'merge-sha',
            head: { sha: 'head-sha' },
            base: { sha: 'base-sha' },
          }),
          { status: 200, headers: { 'Content-Type': 'application/json' } }
        );
      }) as any;

    const { GET } = await import('@/app/api/v1/deploy-requests/[requestId]/merge-readiness/route');
    const response = await GET(
      new NextRequest('http://localhost/api/v1/deploy-requests/req-1/merge-readiness'),
      { params: Promise.resolve({ requestId: 'req-1' }) }
    );

    expect(response.status).toBe(200);
    expect(mockGetAppTokenForRepo).toHaveBeenCalledWith('acme/widgets');
  });

  it('returns a user-friendly error when fallback PAT cannot access the repo', async () => {
    mockGetAppTokenForRepo.mockResolvedValue(null);

    global.fetch = vi.fn(async () => {
      return new Response(
        JSON.stringify({ message: 'Resource not accessible by personal access token' }),
        { status: 403, headers: { 'Content-Type': 'application/json' } }
      );
    }) as any;

    const { GET } = await import('@/app/api/v1/deploy-requests/[requestId]/merge-readiness/route');
    const response = await GET(
      new NextRequest('http://localhost/api/v1/deploy-requests/req-1/merge-readiness'),
      { params: Promise.resolve({ requestId: 'req-1' }) }
    );
    const body = await response.json();

    expect(response.status).toBe(500);
    expect(body.error.message).toBe('GitHub App not installed on this repo (acme/widgets)');
  });
});
